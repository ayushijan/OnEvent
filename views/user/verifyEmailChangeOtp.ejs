<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Verify New Email</title>

</head>

<body>

    <h1>Verify New Email</h1>

    <p>
        Enter the OTP sent to:
        <strong><%= email %></strong>
    </p>

    <form action="/profile/change-email/verify" method="POST">

        <input
            type="hidden"
            name="email"
            value="<%= email %>"
        >

        <input
            type="text"
            name="otp"
            maxlength="6"
            placeholder="Enter 6-digit OTP"
            required
        >

        <button type="submit">
            Verify OTP
        </button>

    </form>

</body>

</html>