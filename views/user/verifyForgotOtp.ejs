<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Verify OTP</title>

    <link
        rel="stylesheet"
        href="/css/user/otp.css"
    >

</head>

<body>

    <main>

        <h1>Verify OTP</h1>

        <p>
            OTP sent to:
            <strong><%= email %></strong>
        </p>

        <form
            action="/verify-forgot-otp"
            method="POST"
        >

            <input
                type="hidden"
                name="email"
                value="<%= email %>"
            >

            <input
                type="text"
                name="otp"
                maxlength="6"
                placeholder="Enter OTP"
                required
            >

            <button type="submit">
                Verify OTP
            </button>

        </form>

    </main>

</body>

</html>