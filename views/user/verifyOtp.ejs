<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>OnEvent - OTP Verification</title>

    <link
        rel="stylesheet"
        href="/css/user/verifyOtp.css"
    >

</head>


<body>


    <!-- HEADER -->

    <header class="auth-header">

        <a
            href="/"
            class="logo"
        >

            <img
                src="/images/OnEvent LOGO.png"
                alt="OnEvent"
            >

        </a>


        <div class="login-link">

            <span>
                Already have an account?
            </span>

            <a href="/login">
                Log In
            </a>

        </div>

    </header>



    <!-- MAIN -->

    <main class="page-content">


        <section class="otp-card-wrapper">


            <!-- LEFT SIDE -->

            <div class="otp-left">


                <div class="instant-title">

                    <span class="instant-icon">
                        ✓
                    </span>

                    <span>
                        INSTANT VERIFICATION
                    </span>

                </div>



                <div class="verification-info">


                    <div class="verification-heading">


                        <div class="mail-icon">
                            ✉
                        </div>


                        <div>

                            <strong>
                                Direct Email Pass
                            </strong>

                            <span>
                                Secured via OTP validation
                            </span>

                        </div>


                        <span class="fast-badge">
                            FAST & EASY
                        </span>

                    </div>


                    <p>
                        We send a 6-digit confirmation code straight to your
                        email to activate your account without paperwork.
                    </p>

                </div>



                <h2>
                    Your Ticket to Endless<br>
                    Moments
                </h2>


                <p class="left-description">
                    Join millions of festival-goers, tech conference
                    attendees, and live event enthusiasts worldwide.
                </p>



                <div class="feature-box">


                    <div class="feature-icon">
                        ✓
                    </div>


                    <div>

                        <strong>
                            Instant activation for booked concert & tech tickets
                        </strong>

                    </div>

                </div>



                <div class="feature-box">


                    <div class="feature-icon">
                        ◈
                    </div>


                    <div>

                        <strong>
                            Encrypted single-use token verification
                        </strong>

                    </div>

                </div>



                <!-- REVIEW -->

                <div class="rating">


                    <div class="review-avatars">

                        <!-- Use the SAME three image paths used on signup -->

                        <img
                            src="/images/review-1.png"
                            alt="Reviewer"
                        >

                        <img
                            src="/images/review-2.png"
                            alt="Reviewer"
                        >

                        <img
                            src="/images/review-3.png"
                            alt="Reviewer"
                        >

                    </div>


                    <span class="star">
                        ★
                    </span>


                    <strong>
                        4.9 / 5
                    </strong>


                    <span>
                        rating from 450k+ reviews
                    </span>

                </div>


            </div>



            <!-- RIGHT SIDE -->

            <div class="otp-right">


                <div class="security-badge">

                    <span>•</span>

                    STEP 2 OF 2 • SECURITY CHECK

                </div>



                <h1>
                    Verify Your Account
                </h1>


                <p class="description">
                    Enter the 6-digit OTP sent to your email to verify your account.
                </p>



                <!-- EMAIL -->

                <div class="email-box">


                    <div class="email-icon">
                        ✉
                    </div>


                    <div class="email-content">

                        <span>
                            Sent to
                        </span>

                        <strong>
                            <%= email %>
                        </strong>

                    </div>


                    <a href="#">
                        Change Email
                    </a>

                </div>



                <!-- OTP -->

                <label class="otp-label">
                    ONE-TIME PASSWORD (OTP)
                </label>


                <form
                    id="otpForm"
                    method="POST"
                    action="/verify-otp"
                >


                    <input
                        type="hidden"
                        name="email"
                        value="<%= email %>"
                    >


                    <div class="otp-inputs">


                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                        >

                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                        >

                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                        >

                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                        >

                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                        >

                        <input
                            type="text"
                            maxlength="1"
                            class="otp-box"
                            inputmode="numeric"
                        >


                    </div>


                    <input
                        type="hidden"
                        name="otp"
                        id="otpValue"
                    >


                    <p class="otp-helper">
                        Enter digits individually or paste your 6-digit code.
                    </p>



                    <button
                        type="submit"
                        class="verify-button"
                    >

                        Verify OTP

                        <span>
                            →
                        </span>

                    </button>


                </form>



                <!-- RESEND -->

                <div class="resend-container">

                    <span class="resend-icon">
                        ◷
                    </span>

                    <span>
                        Resend OTP in
                    </span>

                    <span class="timer">
                        00:59
                    </span>

                    <span class="divider">
                        |
                    </span>

                    <button
                        type="button"
                        class="resend-btn"
                        disabled
                    >
                        Resend Code
                    </button>

                </div>


                <p class="resend-helper">
                    Didn't receive the email? Check your inbox or change your email above.
                </p>



                <!-- BOTTOM -->

                <div class="otp-bottom-links">


                    <a href="/signup">
                        ← Back to Sign Up
                    </a>


                    <a href="#">
                        Need help?
                        <span>Support</span>
                    </a>


                </div>


            </div>


        </section>


    </main>



    <!-- FOOTER -->

    <footer class="auth-footer">


        <span>
            © 2026 OnEvent Platform Inc. All rights reserved.
        </span>


        <div>

            <a href="#">
                Privacy Policy
            </a>

            <a href="#">
                Terms of Service
            </a>

            <a href="#">
                Help & Support
            </a>

        </div>


    </footer>



    <script src="/js/verifyOtp.js?v=2"></script>

</body>

</html>