<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OnEvent - Change Password</title>

    <link rel="stylesheet" href="/css/user/navbar.css">
    <link rel="stylesheet" href="/css/user/changePassword.css">
    <link rel="stylesheet" href="/css/user/footer.css">
</head>

<body>

    <!-- Shared Navbar -->
    <%- include("../partials/navbar") %>

    <main class="change-password-page">

        <!-- Page Heading -->
        <section class="password-page-heading">

            <div class="heading-content">

                <div class="breadcrumb">
                    <a href="/">⌂ Home</a>
                    <span>›</span>
                    <a href="/profile">My Profile</a>
                    <span>›</span>
                    <strong>Change Password</strong>
                </div>

                <h1>
                    Change Password

                    <span class="verification-badge">
                        <span class="verification-dot"></span>
                        Active Verified
                    </span>
                </h1>

                <p>Update your password to keep your account secure.</p>

            </div>

            <div class="account-badge">
                <span>♙</span>
                Attendee Account
            </div>

        </section>


        <!-- Main Layout -->
        <section class="password-layout">

            <!-- Left Sidebar -->
            <aside class="password-sidebar">

                <!-- Profile Card -->
                <div class="profile-card">

                    <div class="profile-cover"></div>

                    <div class="profile-avatar-wrapper">

                        <% if (user && user.profileImage) { %>

                            <img
                                src="<%= user.profileImage %>"
                                alt="Profile picture"
                                class="profile-avatar"
                            >

                        <% } else { %>

                            <div class="profile-avatar avatar-placeholder">
                                <%= user && user.name
                                    ? user.name.charAt(0).toUpperCase()
                                    : "U" %>
                            </div>

                        <% } %>

                    </div>

                    <div class="profile-identity">

                        <h2>
                            <%= user && user.name ? user.name : "Attendee" %>
                        </h2>

                        <p class="member-label">
                            Attendee · OnEvent Member
                            <span class="verified-check">✓</span>
                        </p>

                        <div class="contact-box">

                            <div class="contact-item">
                                <span>✉</span>

                                <span class="contact-value">
                                    <%= user && user.email ? user.email : "" %>
                                </span>
                            </div>

                            <div class="contact-item">
                                <span>☎</span>

                                <span class="contact-value">
                                    <%= user && user.phone
                                        ? user.phone
                                        : "Phone not provided" %>
                                </span>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Sidebar Navigation -->
                <nav class="profile-menu">

                    <a href="/profile" class="menu-item">
                        <span class="menu-icon">▣</span>
                        <span>Profile Overview</span>
                    </a>

                    <a href="/profile/edit" class="menu-item">
                        <span class="menu-icon">✎</span>
                        <span>Edit Profile</span>
                    </a>

                    <% if (user && user.authProvider === "local") { %>

                        <a
                            href="/profile/change-password"
                            class="menu-item active"
                        >
                            <span class="menu-icon">◉</span>
                            <span>Change Password</span>
                            <span class="menu-arrow">→</span>
                        </a>

                    <% } %>

                    <a href="/wallet" class="menu-item">
                        <span class="menu-icon">▣</span>
                        <span>Wallet</span>
                    </a>

                </nav>


                <!-- Account Engagement -->
                <div class="engagement-card">

                    <div class="engagement-heading">
                        <h3>ACCOUNT ENGAGEMENT</h3>
                        <span>↗</span>
                    </div>

                    <div class="engagement-stats">

                        <div class="engagement-stat">
                            <strong>02</strong>
                            <span>Booked Events</span>
                        </div>

                        <div class="engagement-stat">
                            <strong>02</strong>
                            <span>Verified Passes</span>
                        </div>

                    </div>

                    <div class="verified-attendee">

                        <span class="verified-icon">✓</span>

                        <div>
                            <strong>100% Verified Attendee</strong>

                            <p>
                                Digital KYC &amp; ticketing integrity ready
                            </p>
                        </div>

                    </div>

                </div>

            </aside>


            <!-- Right Side -->
            <section class="password-content">

                <div class="password-card">

                    <!-- Form Heading -->
                    <div class="password-card-heading">

                        <div>
                            <h2>Change Password</h2>

                            <p>
                                Update your password to keep your account secure.
                            </p>
                        </div>

                        <span class="security-badge">
                            ✓ End-to-End Encrypted
                        </span>

                    </div>


                    <!-- Success Message -->
                    <% if (
                        typeof successMessage !== "undefined" &&
                        successMessage
                    ) { %>

                        <div class="form-message success-message" role="status">
                            <span>✓</span>
                            <%= successMessage %>
                        </div>

                    <% } %>


                    <!-- Change Password Form -->
                    <form
                        action="/profile/change-password"
                        method="POST"
                        id="changePasswordForm"
                        novalidate
                    >

                        <!-- Current Password -->
                        <div class="form-field">

                            <div class="label-row">

                                <label for="currentPassword">
                                    Current Password
                                    <span class="required">*</span>
                                </label>

                                <a
                                    href="/forgot-password"
                                    class="forgot-password-link"
                                >
                                    Forgot your current password?
                                </a>

                            </div>

                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="currentPassword"
                                    name="currentPassword"
                                    placeholder="Enter current password"
                                    autocomplete="current-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="toggle-password"
                                    data-target="currentPassword"
                                    aria-label="Show current password"
                                    aria-pressed="false"
                                >
                                    <img
                                        src="/icons/eye-off.svg"
                                        alt=""
                                        class="password-eye-icon"
                                    >
                                </button>

                            </div>

                            <!-- Server-side Current Password Error -->
                            <p
                                class="field-error"
                                id="currentPasswordError"
                                role="alert"
                                aria-live="polite"
                                <%= typeof errorMessage !== "undefined" && errorMessage
                                    ? 'style="display:block"'
                                    : 'style="display:none"' %>
                            ><%= typeof errorMessage !== "undefined"
                                ? errorMessage
                                : "" %></p>

                        </div>


                        <!-- New Password -->
                        <div class="form-field">

                            <label for="newPassword">
                                New Password
                                <span class="required">*</span>
                            </label>

                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="newPassword"
                                    name="newPassword"
                                    placeholder="Create a strong password"
                                    autocomplete="new-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="toggle-password"
                                    data-target="newPassword"
                                    aria-label="Show new password"
                                    aria-pressed="false"
                                >
                                    <img
                                        src="/icons/eye-off.svg"
                                        alt=""
                                        class="password-eye-icon"
                                    >
                                </button>

                            </div>

                            <p
                                class="field-error"
                                id="newPasswordError"
                                role="alert"
                                aria-live="polite"
                            ></p>

                        </div>


                        <!-- Confirm Password -->
                        <div class="form-field">

                            <label for="confirmPassword">
                                Confirm New Password
                                <span class="required">*</span>
                            </label>

                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    placeholder="Re-enter your new password"
                                    autocomplete="new-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="toggle-password"
                                    data-target="confirmPassword"
                                    aria-label="Show confirmation password"
                                    aria-pressed="false"
                                >
                                    <img
                                        src="/icons/eye-off.svg"
                                        alt=""
                                        class="password-eye-icon"
                                    >
                                </button>

                            </div>

                            <p
                                class="field-error"
                                id="confirmPasswordError"
                                role="alert"
                                aria-live="polite"
                            ></p>

                        </div>


                        <!-- Password Requirements -->
                        <div class="password-requirements">

                            <h3>PASSWORD REQUIREMENTS</h3>

                            <div class="requirements-grid">

                                <p id="requirementLength">
                                    <span>○</span>
                                    At least 8 characters
                                </p>

                                <p id="requirementUppercase">
                                    <span>○</span>
                                    One uppercase letter
                                </p>

                                <p id="requirementLowercase">
                                    <span>○</span>
                                    One lowercase letter
                                </p>

                                <p id="requirementNumber">
                                    <span>○</span>
                                    One number
                                </p>

                                <p id="requirementSpecial">
                                    <span>○</span>
                                    One special character
                                </p>

                            </div>

                        </div>


                        <!-- Form Actions -->
                        <div class="password-form-actions">

                            <button
                                type="submit"
                                class="update-password-button"
                            >
                                <span>✓</span>
                                Update Password
                            </button>

                            <a href="/profile" class="cancel-button">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </section>

        </section>


        <!-- Feature Cards -->
        <section class="password-feature-grid">

            <article class="feature-card">

                <div class="feature-icon">▣</div>

                <div>
                    <h3>Instant Pass Delivery</h3>

                    <p>
                        Your verified tickets are tied directly to your
                        authenticated email and mobile number.
                    </p>
                </div>

            </article>


            <article class="feature-card">

                <div class="feature-icon">♙</div>

                <div>
                    <h3>Encrypted Credentials</h3>

                    <p>
                        Your account information should be protected
                        and handled securely.
                    </p>
                </div>

            </article>


            <article class="feature-card">

                <div class="feature-icon">◷</div>

                <div>
                    <h3>24/7 Attendee Helpdesk</h3>

                    <p>
                        Need help with your account? Contact our support team.
                    </p>
                </div>

            </article>

        </section>

    </main>


    <!-- Shared Footer -->
    <%- include("../partials/footer") %>


    <!-- Password Page JavaScript -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("changePasswordForm");

            const currentPassword =
                document.getElementById("currentPassword");

            const newPassword =
                document.getElementById("newPassword");

            const confirmPassword =
                document.getElementById("confirmPassword");

            const currentPasswordError =
                document.getElementById("currentPasswordError");

            const newPasswordError =
                document.getElementById("newPasswordError");

            const confirmPasswordError =
                document.getElementById("confirmPasswordError");

            const successMessage =
                document.querySelector(".success-message");


            // =====================================
            // SHOW / HIDE PASSWORD
            // =====================================

            document.querySelectorAll(".toggle-password").forEach(
                function (button) {

                    const input = document.getElementById(
                        button.dataset.target
                    );

                    const icon = button.querySelector(
                        ".password-eye-icon"
                    );

                    if (!input || !icon) {
                        return;
                    }

                    function updatePasswordIcon() {

                        const isHidden = input.type === "password";

                        icon.src = isHidden
                            ? "/icons/eye-off.svg"
                            : "/icons/eye.svg";

                        button.setAttribute(
                            "aria-label",
                            isHidden ? "Show password" : "Hide password"
                        );

                        button.setAttribute(
                            "aria-pressed",
                            isHidden ? "false" : "true"
                        );
                    }

                    updatePasswordIcon();

                    button.addEventListener("click", function () {

                        input.type = input.type === "password"
                            ? "text"
                            : "password";

                        updatePasswordIcon();

                    });

                }
            );


            // =====================================
            // PASSWORD REQUIREMENTS
            // =====================================

            const requirements = [
                {
                    element: document.getElementById("requirementLength"),
                    test: value => value.length >= 8
                },
                {
                    element: document.getElementById("requirementUppercase"),
                    test: value => /[A-Z]/.test(value)
                },
                {
                    element: document.getElementById("requirementLowercase"),
                    test: value => /[a-z]/.test(value)
                },
                {
                    element: document.getElementById("requirementNumber"),
                    test: value => /[0-9]/.test(value)
                },
                {
                    element: document.getElementById("requirementSpecial"),
                    test: value => /[^A-Za-z0-9]/.test(value)
                }
            ];


            function updatePasswordRequirements() {

                requirements.forEach(function (requirement) {

                    const passed = requirement.test(newPassword.value);

                    requirement.element.classList.toggle(
                        "requirement-passed",
                        passed
                    );

                    requirement.element.querySelector("span").textContent =
                        passed ? "✓" : "○";

                });

            }


            // =====================================
            // ERROR HELPERS
            // =====================================

            function showError(element, message) {
                element.textContent = message;
                element.style.display = message ? "block" : "none";
            }


            function clearError(element) {
                showError(element, "");
            }


            // =====================================
            // SERVER ERROR HANDLING
            // =====================================

            currentPassword.addEventListener("input", function () {

                clearError(currentPasswordError);

                if (successMessage) {
                    successMessage.style.display = "none";
                }

            });


            // =====================================
            // NEW PASSWORD INPUT
            // =====================================

            newPassword.addEventListener("input", function () {

                updatePasswordRequirements();

                clearError(newPasswordError);

                if (successMessage) {
                    successMessage.style.display = "none";
                }

                if (confirmPassword.value !== "") {
                    validateConfirmation();
                }

            });


            // =====================================
            // CONFIRM PASSWORD VALIDATION
            // =====================================

            function validateConfirmation() {

                if (
                    confirmPassword.value !== "" &&
                    confirmPassword.value !== newPassword.value
                ) {

                    showError(
                        confirmPasswordError,
                        "Passwords do not match."
                    );

                    return false;
                }

                clearError(confirmPasswordError);

                return true;
            }


            confirmPassword.addEventListener("input", function () {

                validateConfirmation();

                if (successMessage) {
                    successMessage.style.display = "none";
                }

            });


            // =====================================
            // FORM SUBMISSION VALIDATION
            // =====================================

            form.addEventListener("submit", function (event) {

                let isValid = true;

                clearError(currentPasswordError);
                clearError(newPasswordError);
                clearError(confirmPasswordError);


                // Validate current password input.
                if (!currentPassword.value.trim()) {

                    showError(
                        currentPasswordError,
                        "Please enter your current password."
                    );

                    isValid = false;
                }


                // Validate new password.
                const allRequirementsPassed = requirements.every(
                    requirement => requirement.test(newPassword.value)
                );


                // The new password must differ from the current password.
                if (
                    currentPassword.value &&
                    newPassword.value === currentPassword.value
                ) {

                    showError(
                        newPasswordError,
                        "New password must be different from current password."
                    );

                    isValid = false;

                } else if (!newPassword.value) {

                    showError(
                        newPasswordError,
                        "Please enter a new password."
                    );

                    isValid = false;

                } else if (!allRequirementsPassed) {

                    showError(
                        newPasswordError,
                        "Please meet all password requirements."
                    );

                    isValid = false;
                }


                // Validate confirmation.
                if (!confirmPassword.value) {

                    showError(
                        confirmPasswordError,
                        "Please confirm your new password."
                    );

                    isValid = false;

                } else if (confirmPassword.value !== newPassword.value) {

                    showError(
                        confirmPasswordError,
                        "Passwords do not match."
                    );

                    isValid = false;
                }


                // Prevent submission if client-side validation fails.
                if (!isValid) {
                    event.preventDefault();
                }

            });

        });
    </script>

</body>

</html>
