<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>OnEvent - Login</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/user/login.css">

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header class="auth-header">

        <div class="logo">

            <a href="/">

                <img
                    src="/images/OnEvent%20LOGO.png"
                    alt="OnEvent"
                >

            </a>

        </div>

    </header>



    <!-- ================= MAIN ================= -->

    <main class="login-container">


        <!-- ================= LEFT PANEL ================= -->

        <section class="login-left">


            <!-- Seamless Access -->

            <div class="access-title">

                <span class="access-icon">

                    <img
                        src="/icons/ticket.svg"
                        alt=""
                    >

                </span>

                <span>
                    SEAMLESS ACCESS
                </span>

            </div>



            <!-- Fast Track -->

            <div class="track-card">

                <div class="track-header">

                    <div class="track-icon">

                        <img
                            src="/icons/zap.svg"
                            alt=""
                        >

                    </div>


                    <div class="track-text">

                        <strong>
                            FAST TRACK READY
                        </strong>

                        <span>
                            1-Click Saved Booking
                        </span>

                    </div>


                    <span class="active-badge">
                        ACTIVE PASSES
                    </span>

                </div>


                <p>
                    Log in to instantly view your upcoming QR access tickets,
                    manage reserved seats, and receive real-time event updates.
                </p>

            </div>



            <!-- Heading -->

            <h2>
                Your Ticket to Endless<br>
                Moments
            </h2>


            <p class="left-description">
                Join millions of festival-goers, tech conference attendees,
                and live event enthusiasts worldwide.
            </p>



            <!-- Feature 1 -->

            <div class="feature">

                <div class="feature-icon">

                    <img
                        src="/icons/shield-check.svg"
                        alt=""
                    >

                </div>

                <div>

                    <strong>
                        End-to-end encrypted single-use tokens
                    </strong>

                </div>

            </div>



            <!-- Feature 2 -->

            <div class="feature">

                <div class="feature-icon">

                    <img
                        src="/icons/qr-code.svg"
                        alt=""
                    >

                </div>

                <div>

                    <strong>
                        Instant offline QR phone pass entry
                    </strong>

                </div>

            </div>



            <!-- Reviews -->

            <div class="reviews">

                <div class="review-avatars">

                    <img
                        src="/images/review-1.png"
                        alt="Reviewer 1"
                    >

                    <img
                        src="/images/review-2.png"
                        alt="Reviewer 2"
                    >

                    <img
                        src="/images/review-3.png"
                        alt="Reviewer 3"
                    >

                </div>


                <div class="review-content">

                    <div>

                        <img
                            src="/icons/star.svg"
                            class="rating-star"
                            alt=""
                        >

                        <strong>
                            4.9 / 5
                        </strong>

                    </div>

                    <span>
                        from 450k+ attendee reviews
                    </span>

                </div>

            </div>


        </section>



        <!-- ================= RIGHT PANEL ================= -->

        <section class="login-right">


            <span class="form-badge">
                ● ATTENDEE PORTAL
            </span>


            <h1>
                Welcome Back
            </h1>


            <p class="login-description">
                Log in to continue discovering and booking events.
            </p>



            <!-- Google -->

            <a
                href="/auth/google"
                class="google-btn"
            >

                <span class="google-icon">

                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        xmlns="http://www.w3.org/2000/svg"
                    >

                        <path
                            fill="#4285F4"
                            d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.258h2.908c1.702-1.567 2.684-3.88 2.684-6.614z"
                        />

                        <path
                            fill="#34A853"
                            d="M9 18c2.43 0 4.467-.806 5.956-2.181l-2.908-2.258c-.806.54-1.834.859-3.048.859-2.344 0-4.33-1.584-5.039-3.714H.955v2.332A9 9 0 0 0 9 18z"
                        />

                        <path
                            fill="#FBBC05"
                            d="M3.961 10.706A5.41 5.41 0 0 1 3.678 9c0-.592.102-1.168.283-1.706V4.962H.955A9 9 0 0 0 0 9c0 1.452.348 2.827.955 4.038l3.006-2.332z"
                        />

                        <path
                            fill="#EA4335"
                            d="M9 3.58c1.323 0 2.507.455 3.44 1.347l2.581-2.581C13.463.891 11.426 0 9 0A9 9 0 0 0 .955 4.962l3.006 2.332C4.67 5.164 6.656 3.58 9 3.58z"
                        />

                    </svg>

                </span>

                Continue with Google

            </a>



            <!-- Divider -->

            <div class="divider">

                <span></span>

                <p>
                    OR CONTINUE WITH EMAIL
                </p>

                <span></span>

            </div>



            <!-- Login Form -->

            <form
                action="/login"
                method="POST"
                id="loginForm"
            >


                <!-- Email -->

                <div class="form-group">

                    <label for="email">
                        EMAIL ADDRESS <span>*</span>
                    </label>


                    <div class="input-wrapper">

                        <img
                            src="/icons/mail.svg"
                            class="input-icon"
                            alt=""
                        >


                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                        >

                    </div>


                    <p class="field-helper">
                        We'll verify your booking confirmation tickets through this address.
                    </p>

                </div>



                <!-- Password -->

                <div class="form-group">

                    <label for="password">
                        PASSWORD <span>*</span>
                    </label>


                    <div class="input-wrapper">

                        <img
                            src="/icons/lock-keyhole.svg"
                            class="input-icon"
                            alt=""
                        >


                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            required
                        >


                        <img
                            src="/icons/eye-off.svg"
                            class="eye-icon"
                            alt="Show password"
                            id="passwordEye"
                        >

                    </div>

                </div>



                <!-- Remember / Forgot -->

                <div class="login-options">

                    <label class="remember">

                        <input
                            type="checkbox"
                            name="rememberMe"
                        >

                        <span>
                            Remember Me
                        </span>

                    </label>


                    <a href="/forgot-password">
                        Forgot Password?
                    </a>

                </div>


                <% if (blocked) { %>
                    <div class="blocked-message" id="blockedMessage">
                        <div class="blocked-icon">⚠</div>
                
                        <div>
                            <strong>Account Blocked</strong>
                            <p>Your account has been blocked by the administrator.</p>
                        </div>
                    </div>
                    <% } %>



                <!-- Login -->

                <button
                    type="submit"
                    class="login-button"
                >

                    Log In

                    <span>
                        →
                    </span>

                </button>


            </form>



            <!-- Signup -->

            <p class="signup-link">

                Don't have an account?

                <a href="/signup">
                    Sign Up
                </a>

            </p>


        </section>


    </main>



    <!-- ================= FOOTER ================= -->

    <footer class="auth-footer">

        <span>
            © 2026 OnEvent Platform Inc. All rights reserved.
        </span>


        <div>

            <a href="/privacy">
                Privacy Policy
            </a>

            <a href="/terms">
                Terms of Service
            </a>

            <a href="/contact">
                Help & Support
            </a>

        </div>

    </footer>


    <script src="/js/login.js"></script>

    <script>
    const blockedMessage = document.getElementById("blockedMessage");

    if (blockedMessage) {
        window.history.replaceState({}, document.title, "/login");
    }
</script>

</body>

</html>