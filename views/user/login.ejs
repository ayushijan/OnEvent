<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OnEvent - Login</title>

    <link rel="stylesheet" href="/css/user/login.css">

    <style>
        .login-error {
            display: block;
            color: #d93025;
            font-size: 12px;
            margin-top: 7px;
            line-height: 1.5;
        }

        .input-wrapper.has-error {
            border-color: #d93025;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header class="auth-header">
        <a href="/" class="logo" aria-label="OnEvent home">
            <img src="/images/OnEvent%20LOGO.png" alt="OnEvent">
        </a>
    </header>


    <!-- LOGIN CARD -->
    <main class="login-container">

        <!-- LEFT PANEL -->
        <section class="login-left">

            <div class="access-title">
                <span class="access-icon">
                    <img src="/icons/shield-check.svg" alt="">
                </span>
                <span>SECURE ACCESS</span>
            </div>

            <!-- EVENT JOURNEY CARD -->
            <div class="track-card">

                <div class="track-header">

                    <span class="track-icon">
                        <img src="/icons/zap.svg" alt="">
                    </span>

                    <div class="track-text">
                        <strong>Your Event Journey</strong>
                        <span>Everything starts here</span>
                    </div>

                    <span class="active-badge">READY</span>

                </div>

                <p>
                    Sign in to explore events, manage your bookings,
                    and keep your experiences organised.
                </p>

            </div>

            <!-- LEFT HEADING -->
            <h2>
                Your next experience<br>
                starts here.
            </h2>

            <p class="left-description">
                Discover amazing events, reserve your spot,
                and make every moment memorable with OnEvent.
            </p>

            <!-- FEATURE 1 -->
            <div class="feature">
                <span class="feature-icon">
                    <img src="/icons/ticket.svg" alt="">
                </span>
                <strong>Easy event booking</strong>
            </div>

            <!-- FEATURE 2 -->
            <div class="feature">
                <span class="feature-icon">
                    <img src="/icons/badge-check.svg" alt="">
                </span>
                <strong>Keep track of your bookings</strong>
            </div>

            <!-- FEATURE 3 -->
            <div class="feature">
                <span class="feature-icon">
                    <img src="/icons/lock-keyhole.svg" alt="">
                </span>
                <strong>Secure account access</strong>
            </div>

            <!-- REVIEWS -->
            <div class="reviews">

                <div class="review-avatars">
                    <img src="/images/review-1.png" alt="Event attendee">
                    <img src="/images/review-2.png" alt="Event attendee">
                    <img src="/images/review-3.png" alt="Event attendee">
                </div>

                <div class="review-content">

                    <div>
                        <img src="/icons/star.svg" alt="" class="rating-star">
                        <strong>Made for experiences</strong>
                    </div>

                    <span>Discover something worth remembering.</span>

                </div>

            </div>

        </section>


        <!-- RIGHT PANEL -->
        <section class="login-right">

            <span class="form-badge">WELCOME BACK</span>

            <h1>Login to OnEvent</h1>

            <p class="login-description">
                Enter your details to access your account.
            </p>

            <!-- BLOCKED ACCOUNT MESSAGE -->
            <% if (typeof blocked !== "undefined" && blocked) { %>

                <div class="blocked-message" id="blockedMessage">

                    <span class="blocked-icon">!</span>

                    <div>
                        <strong>Account blocked</strong>

                        <p>
                            Your account has been blocked.
                            Please contact support.
                        </p>
                    </div>

                </div>

            <% } %>

            <!-- GOOGLE LOGIN -->
            <a href="/auth/google" class="google-btn">

                <span class="google-icon">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 48 48"
                        aria-hidden="true"
                    >
                        <path
                            fill="#EA4335"
                            d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                        />

                        <path
                            fill="#4285F4"
                            d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.76 7.18l7.73 6C44.42 37.91 46.98 31.77 46.98 24.55z"
                        />

                        <path
                            fill="#FBBC05"
                            d="M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.9 23.9 0 0 0 0 24c0 3.87.93 7.52 2.56 10.78l7.97-6.19z"
                        />

                        <path
                            fill="#34A853"
                            d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                        />
                    </svg>

                </span>

                Continue with Google

            </a>

            <!-- DIVIDER -->
            <div class="divider">
                <span></span>
                <p>OR CONTINUE WITH EMAIL</p>
                <span></span>
            </div>


            <!-- LOGIN FORM -->
            <form
                action="/login"
                method="POST"
                id="loginForm"
                autocomplete="on"
                novalidate
            >

                <!-- EMAIL -->
                <div class="form-group">

                    <label for="email">
                        Email <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            required
                        >

                    </div>

                    <% if (typeof emailError !== "undefined" && emailError) { %>

                        <small class="login-error server-login-error">
                            <%= emailError %>
                        </small>

                    <% } %>

                </div>


                <!-- PASSWORD -->
                <div class="form-group">

                    <label for="password">
                        Password <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                    </div>

                    <% if (typeof error !== "undefined" && error) { %>

                        <small
                            class="login-error server-login-error"
                            id="loginError"
                        ><%= error %></small>

                    <% } %>

                </div>


                <!-- REMEMBER / FORGOT -->
                <div class="login-options">

                    <label class="remember" for="rememberMe">

                        <input
                            type="checkbox"
                            id="rememberMe"
                            name="rememberMe"
                        >

                        Remember me

                    </label>

                    <a href="/forgot-password">Forgot Password?</a>

                </div>


                <!-- LOGIN BUTTON -->
                <button type="submit" class="login-button">
                    Login <span>→</span>
                </button>

            </form>


            <!-- SIGNUP LINK -->
            <p class="signup-link">
                Don't have an account?
                <a href="/signup">Sign Up</a>
            </p>

        </section>

    </main>


    <!-- FOOTER -->
    <footer class="auth-footer">

        <span>
            © <%= new Date().getFullYear() %> OnEvent Platform Inc. All rights reserved.
        </span>

        <div>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/contact">Help &amp; Support</a>
        </div>

    </footer>


    <script>
    // Clear the password when returning through browser history.
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            const password = document.getElementById("password");

            if (password) {
                password.value = "";
            }
        }
    });


    // Remove the blocked query parameter after displaying the message.
    const blockedMessage = document.getElementById("blockedMessage");

    if (blockedMessage) {
        window.history.replaceState(
            {},
            document.title,
            "/login"
        );
    }


    // LOGIN FORM VALIDATION
    const loginForm = document.getElementById("loginForm");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("password");


    // Remove a client-side error from a specific input.
    function removeClientError(input) {
        const wrapper = input.closest(".input-wrapper");

        if (!wrapper) return;

        wrapper.classList.remove("has-error");

        const nextElement = wrapper.nextElementSibling;

        if (
            nextElement &&
            nextElement.classList.contains("client-login-error")
        ) {
            nextElement.remove();
        }
    }


    // Display a client-side validation error.
    function showClientError(input, message) {
        removeClientError(input);

        const wrapper = input.closest(".input-wrapper");

        if (!wrapper) return;

        wrapper.classList.add("has-error");

        const error = document.createElement("small");

        error.className = "login-error client-login-error";
        error.textContent = message;

        wrapper.insertAdjacentElement("afterend", error);
    }


    // Remove server-side errors when the user edits either field.
    function clearServerErrors() {
        document.querySelectorAll(".server-login-error").forEach(function (error) {
            error.remove();
        });
    }


    // Clear errors while the user edits the email field.
    emailInput.addEventListener("input", function () {
        removeClientError(emailInput);
        clearServerErrors();
    });


    // Clear errors while the user edits the password field.
    passwordInput.addEventListener("input", function () {
        removeClientError(passwordInput);
        clearServerErrors();
    });


    // LOGIN FORM SUBMISSION
    loginForm.addEventListener("submit", function (event) {
        let hasError = false;

        // Remove previous client-side errors.
        removeClientError(emailInput);
        removeClientError(passwordInput);

        // Remove old server-side errors before a new submission.
        clearServerErrors();

        const email = emailInput.value.trim();
        const password = passwordInput.value;

        // Email validation.
        if (!email) {
            showClientError(
                emailInput,
                "Please enter your email address."
            );

            hasError = true;

        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            showClientError(
                emailInput,
                "Please enter a valid email address."
            );

            hasError = true;
        }

        // Password validation.
        if (!password.trim()) {
            showClientError(
                passwordInput,
                "Please enter your password."
            );

            hasError = true;
        }

        // Stop submission when validation fails.
        if (hasError) {
            event.preventDefault();
        }
    });
</script>

</body>

</html>