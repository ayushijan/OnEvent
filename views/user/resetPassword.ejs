<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Password Reset Successful | OnEvent</title>

    <link rel="stylesheet" href="/css/user/resetPassword.css">
</head>

<body>

    <main class="success-card">

        <!-- SUCCESS ICON -->
        <div class="success-icon">

            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="38"
                height="38"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M20 6 9 17l-5-5"></path>
            </svg>

        </div>


        <!-- SUCCESS BADGE -->
        <span class="success-badge">
            PASSWORD UPDATED
        </span>


        <!-- HEADING -->
        <h1>Password reset successfully!</h1>


        <!-- DESCRIPTION -->
        <p>
            Your password has been updated successfully.
            You can now sign in to OnEvent using your new password.
        </p>


        <!-- LOGIN BUTTON -->
        <a href="/login" class="login-button">
            Go to Login
            <span aria-hidden="true">→</span>
        </a>


        <!-- SECURITY MESSAGE -->
        <div class="security-note">

            <span aria-hidden="true">🔒</span>

            Your account security matters to us.

        </div>

    </main>


    <!-- FOOTER -->
    <footer class="page-footer">

        © <%= new Date().getFullYear() %> OnEvent Platform Inc. All rights reserved.

    </footer>

</body>

</html>