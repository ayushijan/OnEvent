<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choose a New Password | OnEvent</title>
    <link rel="stylesheet" href="/css/user/resetPassword.css">
    <style>
        .reset-subtitle { color:#6b7280; text-align:center; font-size:14px; line-height:1.6; margin:-14px 0 24px; }
        .reset-error { color:#b91c1c; background:#fef2f2; border:1px solid #fecaca; padding:10px 12px; border-radius:7px; font-size:13px; margin-bottom:16px; }
        .password-hint { color:#6b7280; font-size:12px; line-height:1.5; }
        .back-link { display:block; text-align:center; margin-top:18px; color:#5145e5; font-size:13px; }
    </style>
</head>
<body>
    <main>
        <h1>Create a New Password</h1>
        <p class="reset-subtitle">Your email has been verified. Choose a strong password for your OnEvent account.</p>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="reset-error" role="alert"><%= errorMessage %></div>
        <% } %>

        <form action="/reset-password" method="POST" id="resetPasswordForm">
            <div>
                <label for="password">New Password</label>
                <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required>
                <span class="password-hint">At least 8 characters, including uppercase, lowercase, number and special character.</span>
            </div>
            <div>
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" autocomplete="new-password" required>
            </div>
            <button type="submit">Update Password</button>
        </form>
        <a class="back-link" href="/login">Back to Login</a>
    </main>
    <script>
        document.getElementById("resetPasswordForm").addEventListener("submit", function (event) {
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            if (password !== confirmPassword) {
                event.preventDefault();
                alert("Passwords do not match.");
            }
        });
    </script>
</body>
</html>
