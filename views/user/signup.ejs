<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>OnEvent - Signup</title>

    <!-- Inter Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/user/signup.css">

</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="auth-header">

        <div class="logo">

            <a href="/">

                <img
                    src="/images/OnEvent%20LOGO.png"
                    alt="OnEvent"
                >

            </a>

        </div>

        <div class="login-link">

            <span>
                Already have an account?
            </span>

            <a href="/login">
                Log In
            </a>

        </div>

    </header>


    <!-- ================= MAIN ================= -->

    <main class="signup-container">

        <!-- ================= LEFT PANEL ================= -->

        <section class="signup-left">

            <!-- Attendee Pass -->

            <div class="pass-title">

                <span class="pass-icon">

                    <img
                        src="/icons/ticket.svg"
                        alt=""
                    >

                </span>

                <span>
                    ATTENDEE PASS
                </span>

            </div>


            <!-- Event Image -->

            <div class="event-image">

                <img
                    src="/images/Signup%20event.webp"
                    alt="Live Event"
                >

                <div class="event-overlay">

                    <span>

                        <img
                            src="/icons/zap.svg"
                            alt=""
                        >

                        Live Concerts & Gatherings

                    </span>

                    <strong>
                        TRENDING
                    </strong>

                </div>

            </div>


            <!-- Left Heading -->

            <h2>
                Your Ticket to Endless Moments
            </h2>

            <p>
                Join millions of festival-goers, tech conference
                attendees, and live event enthusiasts worldwide.
            </p>


            <!-- Feature 1 -->

            <div class="feature">

                <div class="feature-icon">

                    <img
                        src="/icons/badge-check.svg"
                        alt=""
                    >

                </div>

                <div>

                    <strong>
                        10,000+ Verified Experiences
                    </strong>

                    <span>
                        From indie gigs to stadium tours and masterclasses.
                    </span>

                </div>

            </div>


            <!-- Feature 2 -->

            <div class="feature">

                <div class="feature-icon">

                    <img
                        src="/icons/qr-code.svg"
                        alt=""
                    >

                </div>

                <div>

                    <strong>
                        Instant QR Phone Entry
                    </strong>

                    <span>
                        Tap & go directly from your mobile lock screen.
                    </span>

                </div>

            </div>


            <!-- Feature 3 -->

            <div class="feature">

                <div class="feature-icon">

                    <img
                        src="/icons/shield-check.svg"
                        alt=""
                    >

                </div>

                <div>

                    <strong>
                        Zero Hidden Fees Guaranteed
                    </strong>

                    <span>
                        Transparent pricing upfront on every ticket.
                    </span>

                </div>

            </div>


            <!-- Rating -->

            <div class="rating">

                <div class="review-avatars">

                    <img
                        src="/images/review-1.png"
                        alt="Reviewer 1"
                    >

                    <img
                        src="/images/review-2.png"
                        alt="Reviewer 2"
                    >

                    <img
                        src="/images/review-3.png"
                        alt="Reviewer 3"
                    >

                </div>

                <div class="rating-text">

                    <img
                        src="/icons/star.svg"
                        alt=""
                        class="rating-star"
                    >

                    <strong>
                        4.9 / 5
                    </strong>

                    <span>
                        rating from 450k+ reviews
                    </span>

                </div>

            </div>

        </section>


        <!-- ================= RIGHT PANEL ================= -->

        <section class="signup-right">

            <span class="form-badge">
                ● ATTENDEE REGISTRATION
            </span>

            <h1>
                Create Your Account
            </h1>

            <p>
                Join OnEvent and discover your next experience.
            </p>


            <!-- Google -->

            <a
                href="/auth/google"
                class="google-btn"
            >

                <span class="google-icon">

                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        xmlns="http://www.w3.org/2000/svg"
                    >

                        <path
                            fill="#4285F4"
                            d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.614z"
                        />

                        <path
                            fill="#34A853"
                            d="M9 18c2.43 0 4.467-.806 5.956-2.181l-2.908-2.258c-.806.54-1.835.859-3.048.859-2.344 0-4.329-1.584-5.039-3.714H.955v2.332A9 9 0 0 0 9 18z"
                        />

                        <path
                            fill="#FBBC05"
                            d="M3.961 10.706A5.41 5.41 0 0 1 3.68 9c0-.593.102-1.17.281-1.706V4.962H.955A9 9 0 0 0 0 9c0 1.451.347 2.824.955 4.038l3.006-2.332z"
                        />

                        <path
                            fill="#EA4335"
                            d="M9 3.58c1.321 0 2.507.454 3.44 1.345l2.582-2.582C13.463.891 11.426 0 9 0A9 9 0 0 0 .955 4.962l3.006 2.332C4.671 5.164 6.656 3.58 9 3.58z"
                        />

                    </svg>

                </span>

                Continue with Google

            </a>


            <!-- Divider -->

            <div class="divider">

                <span>
                    OR CONTINUE WITH
                </span>

            </div>


            <!-- ================= FORM ================= -->

            <form
                method="POST"
                action="/signup"
                id="signupForm"
            >

                <!-- Full Name -->

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <div class="input-wrapper">

                        <img
                            src="/icons/user-round.svg"
                            class="input-icon"
                            alt=""
                        >

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            required
                        >

                    </div>

                </div>


                <!-- Email -->

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <img
                            src="/icons/mail.svg"
                            class="input-icon"
                            alt=""
                        >

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                        >

                    </div>

                </div>


                <!-- Mobile -->

                <div class="form-group">

                    <label for="phone">
                        Mobile Number
                    </label>

                    <div class="phone-wrapper">

                        <div class="country-code">

                            <span>
                                🇮🇳
                            </span>

                            <span>
                                +91
                            </span>

                            <img
                                src="/icons/chevron-down.svg"
                                alt=""
                            >

                        </div>

                        <div class="phone-input">

                            <img
                                src="/icons/smartphone.svg"
                                class="input-icon"
                                alt=""
                            >

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                placeholder="Enter your mobile number"
                                required
                            >

                        </div>

                    </div>

                </div>


                <!-- Password -->

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <img
                            src="/icons/lock-keyhole.svg"
                            class="input-icon"
                            alt=""
                        >

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a strong password"
                            required
                        >

                        <img
                            src="/icons/eye-off.svg"
                            class="eye-icon"
                            alt="Show password"
                            id="passwordEye"
                        >

                    </div>

                </div>


                <!-- Confirm Password -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm Password
                    </label>

                    <div class="input-wrapper">

                        <img
                            src="/icons/rotate-ccw.svg"
                            class="input-icon"
                            alt=""
                        >

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Re-enter your password"
                            required
                        >

                        <img
                            src="/icons/eye-off.svg"
                            class="eye-icon"
                            alt="Show password"
                            id="confirmpasswordEye"
                        >

                    </div>

                </div>


                <!-- Terms -->

                <div class="terms">

                    <input
                        type="checkbox"
                        id="terms"
                        required
                    >

                    <label for="terms">

                        I agree to the

                        <a href="/terms">
                            Terms & Conditions
                        </a>

                        and

                        <a href="/privacy">
                            Privacy Policy
                        </a>

                        of OnEvent.

                    </label>

                </div>


                <!-- Create Account -->

                <button
                    type="submit"
                    class="signup-btn"
                >

                    Create Account →

                </button>

            </form>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="auth-footer">

        <span>
            © 2026 OnEvent Platform Inc. All rights reserved.
        </span>

        <div>

            <a href="/privacy">
                Privacy Policy
            </a>

            <a href="/terms">
                Terms of Service
            </a>

            <a href="/contact">
                Help & Support
            </a>

        </div>

    </footer>

    <script src="/js/signup.js"></script>

</body>

</html>