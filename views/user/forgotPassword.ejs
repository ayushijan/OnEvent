<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>OnEvent - Forgot Password</title>

    <link
        rel="stylesheet"
        href="/css/user/forgotPassword.css"
    >

    <style>

        .error-message {
            display: block;
            margin-top: 8px;
            margin-bottom: 12px;
            padding: 10px 12px;

            color: #dc2626;
            background: #fff1f0;

            border: 1px solid #fecaca;
            border-radius: 8px;

            font-size: 13px;
            line-height: 1.5;
        }

    </style>

</head>


<body>


    <div class="forgot-container">


        <!-- HEADING -->

        <h1>
            Forgot Password?
        </h1>


        <p>
            Enter your registered email address and we'll send you
            an OTP to reset your password.
        </p>



        <!-- FORGOT PASSWORD FORM -->

        <form
            action="/forgot-password"
            method="POST"
            id="forgotPasswordForm"
        >


            <!-- EMAIL LABEL -->

            <label for="email">
                Email Address
            </label>



            <!-- EMAIL INPUT -->

            <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter your email"
                value="<%= typeof email !== 'undefined' ? email : '' %>"
                required
            >



            <!-- ERROR MESSAGE BELOW EMAIL INPUT -->

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>

                <div
                    class="error-message"
                    id="emailError"
                    role="alert"
                    aria-live="polite"
                >
                    <%= errorMessage %>
                </div>

            <% } %>



            <!-- SEND OTP BUTTON -->

            <button
                type="submit"
                id="sendOtpButton"
            >
                Send OTP
            </button>


        </form>



        <!-- BACK TO LOGIN -->

        <a href="/login">
            ← Back to Login
        </a>


    </div>



    <!-- JAVASCRIPT -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const emailInput =
                document.getElementById("email");

            const emailError =
                document.getElementById("emailError");

            const form =
                document.getElementById("forgotPasswordForm");

            const sendOtpButton =
                document.getElementById("sendOtpButton");


            // =====================================
            // CLEAR ERROR WHEN USER TYPES
            // =====================================

            if (emailInput && emailError) {

                emailInput.addEventListener("input", function () {

                    emailError.style.display = "none";

                });

            }


            // =====================================
            // FORM SUBMISSION
            // =====================================

            form.addEventListener("submit", function () {

                sendOtpButton.disabled = true;

                sendOtpButton.textContent = "Sending OTP...";

            });

        });

    </script>


</body>

</html>