<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OnEvent - Edit Event</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <link rel="stylesheet" href="/css/admin/categories.css">
    <link rel="stylesheet" href="/css/admin/addEvent.css">
    <link rel="stylesheet" href="/css/admin/events.css">
    <link rel="stylesheet" href="/css/admin/editEvent.css">
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <a href="/admin/dashboard" class="brand">
            <img src="/images/OnEvent%20LOGO.png" alt="OnEvent">
            <span class="admin-badge">ADMIN</span>
        </a>

        <nav class="sidebar-nav">

    <a href="/admin/dashboard" class="nav-item">
        <img src="/icons/dashboard.svg" class="nav-icon" alt="">
        <span>Dashboard</span>
    </a>

    <a href="/admin/events" class="nav-item active">
        <img src="/icons/calendar.svg" class="nav-icon" alt="">
        <span>Events</span>
    </a>

    <a href="/admin/categories" class="nav-item">
        <img src="/icons/shapes.svg" class="nav-icon" alt="">
        <span>Categories</span>
    </a>

    <a href="/admin/users" class="nav-item">
        <img src="/icons/users.svg" class="nav-icon" alt="">
        <span>Users</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/ticket.svg" class="nav-icon" alt="">
        <span>Bookings</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/shield-check.svg" class="nav-icon" alt="">
        <span>Attendee Verification</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/reports.svg" class="nav-icon" alt="">
        <span>Reports & Revenue</span>
    </a>

</nav>

        <div class="sidebar-bottom">

            <div class="system-status">
                <span class="status-dot"></span>

                <div>
                    <small>SYSTEM STATUS</small>
                    <strong>Operational</strong>
                </div>
            </div>

        </div>

    </aside>


    <!-- MAIN AREA -->
    <div class="main-area">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="breadcrumbs">
                <a href="/admin/dashboard">Home</a>
                <span class="breadcrumb-separator">/</span>
                <a href="/admin/events">Events</a>
                <span class="breadcrumb-separator">/</span>
                <strong>Edit Event</strong>
            </div>

            <div class="topbar-right">

                <div class="date-badge">
                    <span class="date-icon">◷</span>
                    Last 30 Days
                </div>

                <button type="button" class="icon-button"
                    aria-label="Notifications">

                    <svg class="notification-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">

                        <path
                            d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                        <path
                            d="M10 21h4"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                        />

                    </svg>

                    <span class="notification-dot"></span>

                </button>

                <div class="admin-profile">

                    <span class="admin-avatar">SA</span>

                    <div class="admin-profile-info">
                        <strong>Admin Console</strong>
                        <small>Super Administrator</small>
                    </div>

                </div>

                <form action="/admin/logout" method="POST">

                    <button type="submit" class="topbar-logout">
                        <span>↪</span>
                        Logout
                    </button>

                </form>

            </div>

        </header>


        <!-- PAGE CONTENT -->
        <main class="page-content">

            <!-- PAGE HEADING -->
            <section class="page-heading">

                <div class="heading-copy">

                    <div class="eyebrow">
                        <span>OPERATIONS SUITE</span>
                        <span class="eyebrow-divider">•</span>
                        <span class="eyebrow-muted">
                            EVENT MANAGEMENT
                        </span>
                    </div>

                    <h1>Edit Event</h1>

                    <p>
                        Update event information, ticket details and status.
                    </p>

                </div>

            </section>


            <!-- ERROR MESSAGE -->
            <% if (errorMessage) { %>

                <div class="category-alert error-alert">
                    <%= errorMessage %>
                </div>

            <% } %>


            <!-- EVENT INFORMATION SUMMARY -->
            <section class="edit-event-summary">

                <div>
                    <span>EVENT ID</span>
                    <strong><%= event.eventId %></strong>
                </div>

                <div>
                    <span>TICKETS SOLD</span>
                    <strong><%= event.ticketsSold %></strong>
                </div>

                <div>
                    <span>AVAILABLE TICKETS</span>
                    <strong><%= event.availableTickets %></strong>
                </div>

                <div>
                    <span>PROJECTED REVENUE</span>
                    <strong>
                        ₹<%= Number(projectedRevenue).toLocaleString("en-IN") %>
                    </strong>
                </div>

            </section>


            <!-- EDIT EVENT FORM -->
            <form
                action="/admin/events/edit/<%= event._id %>"
                method="POST"
                enctype="multipart/form-data"
                id="editEventForm"
            >

                <!-- BASIC INFORMATION -->
                <section class="edit-event-card">

                    <div class="edit-card-heading">

                        <div>
                            <h2>Basic Information</h2>
                            <p>Update the event's basic details.</p>
                        </div>

                    </div>


                    <div class="edit-form-grid">

                        <!-- EVENT NAME -->
                        <div class="edit-form-group">

                            <label for="title">
                                Event Name <span>*</span>
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="title"
                                value="<%= event.title %>"
                                maxlength="100"
                                required
                            >

                        </div>


                        <!-- EVENT ID -->
                        <div class="edit-form-group">

                            <label for="eventId">
                                Event ID
                            </label>

                            <input
                                type="text"
                                id="eventId"
                                value="<%= event.eventId %>"
                                readonly
                            >

                            <small>Event ID cannot be changed.</small>

                        </div>


                        <!-- CATEGORY -->
                        <div class="edit-form-group full-width">

                            <label for="categoryId">
                                Event Category <span>*</span>
                            </label>

                            <select
                                name="categoryId"
                                id="categoryId"
                                required
                            >

                                <option value="">
                                    Select Category
                                </option>

                                <% categories.forEach(cat => { %>

                                    <option
                                        value="<%= cat._id %>"
                                        <%= String(event.categoryId._id) === String(cat._id) ? "selected" : "" %>
                                    >
                                        <%= cat.name %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="edit-form-group full-width">

                            <label for="description">
                                Event Description <span>*</span>
                            </label>

                            <textarea
                                id="description"
                                name="description"
                                rows="5"
                                maxlength="2000"
                                required
                            ><%= event.description %></textarea>

                            <small>Maximum 2000 characters.</small>

                        </div>

                    </div>

                </section>


                <!-- EVENT IMAGE -->
                <section class="edit-event-card">

                    <div class="edit-card-heading">

                        <div>
                            <h2>Event Banner / Poster</h2>
                            <p>View the current image or upload a replacement.</p>
                        </div>

                    </div>


                    <div class="edit-image-section">

                        <div class="current-event-image">

                            <% if (imageUrl) { %>

                                <img
                                    src="<%= imageUrl %>"
                                    alt="<%= event.title %>"
                                    id="currentEventImage"
                                >

                            <% } else { %>

                                <div class="image-placeholder"
                                    id="currentEventImage">
                                    No event image
                                </div>

                            <% } %>

                        </div>


                        <div class="edit-image-upload">

                            <label for="image">
                                Replace Event Image
                            </label>

                            <input
                                type="file"
                                name="image"
                                id="image"
                                accept="image/png,image/jpeg"
                            >

                            <small>
                                PNG or JPG. Maximum file size: 5 MB.
                                Leave empty to keep the current image.
                            </small>

                            <div id="newImagePreview"></div>

                        </div>

                    </div>

                </section>


                <!-- DATE AND VENUE -->
                <section class="edit-event-card">

                    <div class="edit-card-heading">

                        <div>
                            <h2>Date & Venue</h2>
                            <p>Update the event schedule and location.</p>
                        </div>

                    </div>


                    <div class="edit-form-grid">

                        <!-- EVENT DATE -->
                        <div class="edit-form-group">

                            <label for="eventDate">
                                Event Date <span>*</span>
                            </label>

                            <input
                                type="date"
                                id="eventDate"
                                name="eventDate"
                                value="<%= new Date(event.eventDate).toISOString().slice(0, 10) %>"
                                required
                            >

                        </div>


                        <!-- START TIME -->
                        <div class="edit-form-group">

                            <label for="startTime">
                                Start Time <span>*</span>
                            </label>

                            <input
                                type="time"
                                id="startTime"
                                name="startTime"
                                value="<%= event.startTime %>"
                                required
                            >

                        </div>


                        <!-- END TIME -->
                        <div class="edit-form-group">

                            <label for="endTime">
                                End Time <span>*</span>
                            </label>

                            <input
                                type="time"
                                id="endTime"
                                name="endTime"
                                value="<%= event.endTime %>"
                                required
                            >

                        </div>


                        <!-- VENUE -->
                        <div class="edit-form-group">

                            <label for="venue">
                                Venue <span>*</span>
                            </label>

                            <input
                                type="text"
                                id="venue"
                                name="venue"
                                value="<%= event.venue %>"
                                maxlength="150"
                                required
                            >

                        </div>


                        <!-- LOCATION -->
                        <div class="edit-form-group full-width">

                            <label for="location">
                                City / Location <span>*</span>
                            </label>

                            <input
                                type="text"
                                id="location"
                                name="location"
                                value="<%= event.location %>"
                                maxlength="150"
                                required
                            >

                        </div>

                    </div>

                </section>


                <!-- TICKET INFORMATION -->
                <section class="edit-event-card">

                    <div class="edit-card-heading">

                        <div>
                            <h2>Ticket Information</h2>
                            <p>Update ticket pricing and event capacity.</p>
                        </div>

                    </div>


                    <div class="edit-form-grid">

                        <!-- TICKET PRICE -->
                        <div class="edit-form-group">

                            <label for="ticketPrice">
                                Ticket Price (₹) <span>*</span>
                            </label>

                            <input
                                type="number"
                                id="ticketPrice"
                                name="ticketPrice"
                                value="<%= event.ticketPrice %>"
                                min="0"
                                step="0.01"
                                required
                            >

                        </div>


                        <!-- TOTAL CAPACITY -->
                        <div class="edit-form-group">

                            <label for="totalTickets">
                                Total Ticket Capacity <span>*</span>
                            </label>

                            <input
                                type="number"
                                id="totalTickets"
                                name="totalTickets"
                                value="<%= event.totalTickets %>"
                                min="<%= event.ticketsSold %>"
                                step="1"
                                required
                            >

                            <small>
                                Capacity cannot be less than tickets already sold.
                            </small>

                        </div>


                        <!-- TICKETS SOLD -->
                        <div class="edit-form-group">

                            <label>Tickets Sold</label>

                            <input
                                type="number"
                                value="<%= event.ticketsSold %>"
                                readonly
                            >

                        </div>


                        <!-- AVAILABLE TICKETS -->
                        <div class="edit-form-group">

                            <label>Available Tickets</label>

                            <input
                                type="number"
                                id="availableTickets"
                                value="<%= event.availableTickets %>"
                                readonly
                            >

                        </div>


                        <!-- PROJECTED REVENUE -->
                        <div class="edit-form-group">

                            <label>Projected Revenue</label>

                            <input
                                type="text"
                                id="projectedRevenue"
                                value="₹<%= Number(projectedRevenue).toLocaleString('en-IN') %>"
                                readonly
                            >

                        </div>


                        <!-- ACTUAL REVENUE -->
                        <div class="edit-form-group">

                            <label>Actual Revenue</label>

                            <input
                                type="text"
                                value="₹<%= Number(actualRevenue).toLocaleString('en-IN') %>"
                                readonly
                            >

                        </div>

                    </div>

                </section>


                <!-- EVENT STATUS -->
                <section class="edit-event-card">

                    <div class="edit-card-heading">

                        <div>
                            <h2>Event Status</h2>
                            <p>Choose the current status of this event.</p>
                        </div>

                    </div>


                    <div class="edit-form-group">

                        <label for="status">
                            Status <span>*</span>
                        </label>

                        <select name="status" id="status" required>

                            <option value="draft"
                                <%= event.status === "draft" ? "selected" : "" %>>
                                Draft
                            </option>

                            <option value="scheduled"
                                <%= event.status === "scheduled" ? "selected" : "" %>>
                                Scheduled
                            </option>

                            <option value="live"
                                <%= event.status === "live" ? "selected" : "" %>>
                                Live
                            </option>

                            <option value="completed"
                                <%= event.status === "completed" ? "selected" : "" %>>
                                Completed
                            </option>

                        </select>

                    </div>

                </section>


                <!-- FORM ACTIONS -->
                <div class="edit-form-actions">

                    <a href="/admin/events" class="secondary-button">
                        Cancel
                    </a>

                    <button type="submit" class="primary-button">
                        Save Changes
                    </button>

                </div>

            </form>


            <!-- FOOTER -->
            <footer class="page-footer">

                <span>OnEvent Administration</span>
                <span>Edit Event</span>

            </footer>

        </main>

    </div>

</div>


<!-- JAVASCRIPT -->
<script>

// ========================================
// IMAGE PREVIEW
// ========================================

const imageInput = document.getElementById("image");

const newImagePreview = document.getElementById("newImagePreview");

imageInput.addEventListener("change", function() {

    newImagePreview.innerHTML = "";

    const file = this.files[0];

    if (!file) return;

    const allowedTypes = ["image/png", "image/jpeg"];

    if (!allowedTypes.includes(file.type)) {
        alert("Only PNG and JPG images are allowed.");
        this.value = "";
        return;
    }

    if (file.size > 5 * 1024 * 1024) {
        alert("Image size cannot exceed 5 MB.");
        this.value = "";
        return;
    }

    const image = document.createElement("img");

    image.src = URL.createObjectURL(file);

    image.alt = "New event image preview";

    image.className = "new-event-preview";

    newImagePreview.appendChild(image);

});


// ========================================
// TICKET CALCULATIONS
// ========================================

const totalTicketsInput = document.getElementById("totalTickets");

const ticketPriceInput = document.getElementById("ticketPrice");

const availableTicketsInput = document.getElementById("availableTickets");

const projectedRevenueInput = document.getElementById("projectedRevenue");

const ticketsSold = Number("<%= event.ticketsSold %>");

function updateTicketCalculations() {

    const totalTickets = Number(totalTicketsInput.value) || 0;

    const ticketPrice = Number(ticketPriceInput.value) || 0;

    const availableTickets = totalTickets - ticketsSold;

    availableTicketsInput.value = Math.max(0, availableTickets);

    const projectedRevenue = totalTickets * ticketPrice;

    projectedRevenueInput.value =
        "₹" + projectedRevenue.toLocaleString("en-IN");

}

totalTicketsInput.addEventListener("input", updateTicketCalculations);

ticketPriceInput.addEventListener("input", updateTicketCalculations);


// ========================================
// FORM VALIDATION
// ========================================

document.getElementById("editEventForm").addEventListener("submit", function(event) {

    const startTime = document.getElementById("startTime").value;

    const endTime = document.getElementById("endTime").value;

    const totalTickets = Number(totalTicketsInput.value);

    if (endTime <= startTime) {

        event.preventDefault();

        alert("End time must be after start time.");

        return;

    }

    if (totalTickets < ticketsSold) {

        event.preventDefault();

        alert("Total capacity cannot be less than tickets already sold.");

        return;

    }

});

</script>

</body>
</html>