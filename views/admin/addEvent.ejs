<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OnEvent - Add Event</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <link rel="stylesheet" href="/css/admin/addCategory.css">
    <link rel="stylesheet" href="/css/admin/addEvent.css">
</head>

<body>

    <div class="admin-layout">

        <!-- =====================================
             SIDEBAR
        ====================================== -->

        <aside class="sidebar">

            <a href="/admin/dashboard" class="brand">

                <img src="/images/OnEvent%20LOGO.png" alt="OnEvent">

                <span class="admin-badge">ADMIN</span>

            </a>

            <nav class="sidebar-nav">

                <a href="/admin/dashboard" class="nav-item">
                    <img src="/icons/dashboard.svg" alt="">
                    <span>Dashboard</span>
                </a>

                <a href="/admin/events" class="nav-item active">
                    <img src="/icons/calendar.svg" alt="">
                    <span>Events</span>
                </a>

                <a href="/admin/categories" class="nav-item">
                    <img src="/icons/shapes.svg" alt="">
                    <span>Categories</span>
                </a>

                <a href="/admin/users" class="nav-item">
                    <img src="/icons/users.svg" alt="">
                    <span>Users</span>
                </a>

                <a href="#" class="nav-item">
                    <img src="/icons/ticket.svg" alt="">
                    <span>Bookings</span>
                </a>

                <a href="#" class="nav-item">
                    <img src="/icons/shield-check.svg" alt="">
                    <span>Attendee Verification</span>
                </a>

                <a href="#" class="nav-item">
                    <img src="/icons/reports.svg" alt="">
                    <span>Reports & Revenue</span>
                </a>

            </nav>

            <div class="sidebar-bottom">

                <div class="system-status">

                    <span class="status-dot"></span>

                    <div>
                        <small>SYSTEM STATUS</small>
                        <strong>Operational</strong>
                    </div>

                </div>

            </div>

        </aside>


        <!-- =====================================
             MAIN AREA
        ====================================== -->

        <div class="main-area">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="breadcrumbs">

                    <span>Home</span>

                    <span class="breadcrumb-separator">/</span>

                    <a href="/admin/events">Events</a>

                    <span class="breadcrumb-separator">/</span>

                    <strong>Add Event</strong>

                </div>


                <div class="topbar-right">

                    <div class="date-badge">
                        <span class="date-icon">◷</span>
                        Last 30 Days
                    </div>

                    <button type="button"
                        class="icon-button"
                        aria-label="Notifications">
                        ♧
                    </button>

                    <div class="admin-profile">

                        <span class="admin-avatar">SA</span>

                        <div class="admin-profile-info">
                            <strong>Admin Console</strong>
                            <small>Super Administrator</small>
                        </div>

                    </div>

                    <button type="button"
                        class="topbar-logout"
                        id="logoutButton">

                        <span>⇥</span>
                        <span>Logout</span>

                    </button>

                </div>

            </header>


            <!-- =====================================
                 PAGE CONTENT
            ====================================== -->

            <main class="page-content add-category-page add-event-page">


                <!-- PAGE HEADING -->

                <section class="page-heading">

                    <div class="heading-copy">

                        <div class="eyebrow">

                            <span>OPERATIONS SUITE</span>

                            <span class="eyebrow-divider">•</span>

                            <span class="eyebrow-muted">
                                EVENT MANAGEMENT
                            </span>

                        </div>

                        <h1>Add Event</h1>

                        <p>
                            Create and configure a new event for OnEvent.
                        </p>

                    </div>


                    <div class="heading-actions">

                        <a href="/admin/events" class="secondary-button">
                            ← Back to List
                        </a>

                    </div>

                </section>


                <!-- =====================================
                     ADD EVENT FORM
                ====================================== -->

                <form
                    action="/admin/events/add"
                    method="POST"
                    enctype="multipart/form-data"
                    id="addEventForm"
                >

                    <section class="category-form-card">


                        <!-- CARD HEADER -->

                        <div class="category-card-header">

                            <div class="category-card-title">

                                <span class="category-section-icon">
                                    ▣
                                </span>

                                <div>

                                    <h2>Event Details</h2>

                                    <p>
                                        Configure event information,
                                        schedule, venue, tickets and media.
                                    </p>

                                </div>

                            </div>

                            <span class="required-label">
                                FIELDS WITH * ARE REQUIRED
                            </span>

                        </div>


                        <div class="category-form-body">


                            <!-- EVENT TITLE -->

                            <div class="form-group">

                                <div class="form-label-row">

                                    <label for="eventTitle">
                                        EVENT TITLE <span>*</span>
                                    </label>

                                    <small>Maximum 100 characters</small>

                                </div>

                                <input
                                    type="text"
                                    id="eventTitle"
                                    name="title"
                                    placeholder="Enter event title"
                                    maxlength="100"
                                    required
                                >

                                <div class="slug-preview">

                                    <span>↗</span>

                                    Event slug:

                                    <code id="slugPreview">
                                        /event/your-event
                                    </code>

                                </div>

                            </div>


                            <!-- EVENT DESCRIPTION -->

                            <div class="form-group">

                                <div class="form-label-row">

                                    <label for="eventDescription">
                                        EVENT DESCRIPTION <span>*</span>
                                    </label>

                                    <small>
                                        <span id="descriptionCount">0</span>
                                        / 2000 characters
                                    </small>

                                </div>

                                <textarea
                                    id="eventDescription"
                                    name="description"
                                    maxlength="2000"
                                    placeholder="Describe your event..."
                                    rows="5"
                                    required
                                ></textarea>

                                <small class="field-help">
                                    Provide details about the event,
                                    activities and experience.
                                </small>

                            </div>


                            <!-- EVENT CATEGORY -->

                            <div class="form-group">

                                <div class="form-label-row">

                                    <label for="eventCategory">
                                        EVENT CATEGORY <span>*</span>
                                    </label>

                                </div>

                                <select
                                    name="categoryId"
                                    id="eventCategory"
                                    required
                                >

                                    <option value="">
                                        Select a category
                                    </option>

                                    <% categories.forEach(category => { %>

                                        <option value="<%= category._id %>">
                                            <%= category.name %>
                                        </option>

                                    <% }) %>

                                </select>

                                <% if (!categories.length) { %>

                                    <small class="field-help">
                                        No active categories available.
                                        Please create or activate a category first.
                                    </small>

                                <% } %>

                            </div>


                            <!-- =====================================
                                 EVENT SCHEDULE
                            ====================================== -->

                            <div class="event-form-section">

                                <h3>Event Schedule</h3>

                                <p>
                                    Set the date and duration of your event.
                                </p>

                                <div class="event-form-grid">


                                    <!-- EVENT DATE -->

                                    <div class="form-group">

                                        <label for="eventDate">
                                            EVENT DATE <span>*</span>
                                        </label>

                                        <input
                                            type="date"
                                            id="eventDate"
                                            name="eventDate"
                                            required
                                        >

                                    </div>


                                    <!-- START TIME -->

                                    <div class="form-group">

                                        <label for="startTime">
                                            START TIME <span>*</span>
                                        </label>

                                        <input
                                            type="time"
                                            id="startTime"
                                            name="startTime"
                                            required
                                        >

                                    </div>


                                    <!-- END TIME -->

                                    <div class="form-group">

                                        <label for="endTime">
                                            END TIME <span>*</span>
                                        </label>

                                        <input
                                            type="time"
                                            id="endTime"
                                            name="endTime"
                                            required
                                        >

                                    </div>

                                </div>

                            </div>


                            <!-- =====================================
                                 VENUE DETAILS
                            ====================================== -->

                            <div class="event-form-section">

                                <h3>Venue Details</h3>

                                <p>
                                    Provide the location where the event takes place.
                                </p>

                                <div class="event-form-grid">


                                    <!-- VENUE -->

                                    <div class="form-group">

                                        <label for="venue">
                                            VENUE <span>*</span>
                                        </label>

                                        <input
                                            type="text"
                                            id="venue"
                                            name="venue"
                                            placeholder="Enter venue name"
                                            maxlength="150"
                                            required
                                        >

                                    </div>


                                    <!-- LOCATION -->

                                    <div class="form-group">

                                        <label for="location">
                                            LOCATION <span>*</span>
                                        </label>

                                        <input
                                            type="text"
                                            id="location"
                                            name="location"
                                            placeholder="Enter city or location"
                                            maxlength="150"
                                            required
                                        >

                                    </div>

                                </div>

                            </div>


                            <!-- =====================================
                                 TICKET INFORMATION
                            ====================================== -->

                            <div class="event-form-section">

                                <h3>Ticket Information</h3>

                                <p>
                                    Configure ticket pricing and availability.
                                </p>

                                <div class="event-form-grid">


                                    <!-- TICKET PRICE -->

                                    <div class="form-group">

                                        <label for="ticketPrice">
                                            TICKET PRICE (₹) <span>*</span>
                                        </label>

                                        <input
                                            type="number"
                                            id="ticketPrice"
                                            name="ticketPrice"
                                            placeholder="0"
                                            min="0"
                                            step="0.01"
                                            required
                                        >

                                        <small class="field-help">
                                            Enter 0 for a free event.
                                        </small>

                                    </div>


                                    <!-- TOTAL TICKETS -->

                                    <div class="form-group">

                                        <label for="totalTickets">
                                            TOTAL TICKETS <span>*</span>
                                        </label>

                                        <input
                                            type="number"
                                            id="totalTickets"
                                            name="totalTickets"
                                            placeholder="Enter ticket capacity"
                                            min="1"
                                            step="1"
                                            required
                                        >

                                    </div>

                                </div>

                            </div>


                            <!-- =====================================
                                 EVENT MEDIA
                            ====================================== -->

                            <div class="event-form-section">

                                <h3>Event Media</h3>

                                <p>
                                    Upload an attractive image to represent your event.
                                </p>

                                <div class="form-group">

                                    <div class="form-label-row">

                                        <label for="eventImage">
                                            EVENT IMAGE
                                        </label>

                                        <small>
                                            PNG or JPG · Maximum 5MB
                                        </small>

                                    </div>


                                    <div class="event-upload-area" id="uploadArea">

                                        <input
                                            type="file"
                                            id="eventImage"
                                            name="image"
                                            accept="image/png,image/jpeg"
                                            hidden
                                        >


                                        <!-- UPLOAD CONTENT -->

                                        <div id="uploadContent">

                                            <div class="event-upload-icon">

                                                <img
                                                    src="/icons/cloudUpload.svg"
                                                    alt="Upload"
                                                >

                                            </div>

                                            <strong>
                                                Click to upload event image
                                            </strong>

                                            <small>
                                                PNG or JPG · Maximum 5MB
                                            </small>

                                        </div>


                                        <!-- SELECTED IMAGE PREVIEW -->

                                        <div
                                            class="event-selected-file"
                                            id="selectedFile"
                                            hidden
                                        >

                                            <img
                                                id="imagePreview"
                                                src=""
                                                alt="Event image preview"
                                            >

                                            <div>

                                                <strong id="fileName"></strong>

                                                <small id="fileSize"></small>

                                            </div>

                                            <button
                                                type="button"
                                                id="removeImage"
                                                aria-label="Remove image"
                                            >
                                                ×
                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- =====================================
                                 EVENT STATUS
                            ====================================== -->

                            <div class="event-form-section">

                                <h3>Event Status</h3>

                                <p>
                                    Choose how your event should be published.
                                </p>

                                <div class="status-options">


                                    <!-- DRAFT -->

                                    <label class="status-option selected">

                                        <input
                                            type="radio"
                                            name="status"
                                            value="draft"
                                            checked
                                        >

                                        <span class="radio-circle"></span>

                                        <div class="status-option-content">

                                            <div class="status-title">

                                                <strong>Draft</strong>

                                                <span class="draft-badge">
                                                    Not Published
                                                </span>

                                            </div>

                                            <p>
                                                Save the event without making
                                                it publicly available.
                                            </p>

                                        </div>

                                    </label>


                                    <!-- SCHEDULED -->

                                    <label class="status-option">

                                        <input
                                            type="radio"
                                            name="status"
                                            value="scheduled"
                                        >

                                        <span class="radio-circle"></span>

                                        <div class="status-option-content">

                                            <div class="status-title">

                                                <strong>Scheduled</strong>

                                                <span class="scheduled-badge">
                                                    Upcoming
                                                </span>

                                            </div>

                                            <p>
                                                Prepare the event for publication
                                                at a future time.
                                            </p>

                                        </div>

                                    </label>


                                    <!-- LIVE -->

                                    <label class="status-option">

                                        <input
                                            type="radio"
                                            name="status"
                                            value="live"
                                        >

                                        <span class="radio-circle"></span>

                                        <div class="status-option-content">

                                            <div class="status-title">

                                                <strong>Live</strong>

                                                <span class="live-badge">
                                                    Published
                                                </span>

                                            </div>

                                            <p>
                                                Make the event available
                                                for public discovery and booking.
                                            </p>

                                        </div>

                                    </label>

                                </div>

                            </div>


                            <!-- =====================================
                                 INFORMATION NOTE
                            ====================================== -->

                            <div class="category-info-note">

                                <span>ⓘ</span>

                                All event details will be stored in the
                                OnEvent event management system.

                            </div>


                            <!-- =====================================
                                 FORM ACTIONS
                            ====================================== -->

                            <div class="form-actions">

                                <a
                                    href="/admin/events"
                                    class="cancel-button"
                                >
                                    Cancel
                                </a>

                                <button
                                    type="submit"
                                    class="submit-category-button"
                                    id="submitEvent"
                                >
                                    + Create Event
                                </button>

                            </div>


                        </div>

                    </section>

                </form>

            </main>

        </div>

    </div>


    <!-- =====================================
         JAVASCRIPT
    ====================================== -->

    <script>

        const form = document.getElementById("addEventForm");

        const titleInput = document.getElementById("eventTitle");

        const descriptionInput =
            document.getElementById("eventDescription");

        const slugPreview = document.getElementById("slugPreview");

        const descriptionCount =
            document.getElementById("descriptionCount");

        const imageInput = document.getElementById("eventImage");

        const uploadArea = document.getElementById("uploadArea");

        const uploadContent = document.getElementById("uploadContent");

        const selectedFile = document.getElementById("selectedFile");

        const imagePreview = document.getElementById("imagePreview");

        const fileName = document.getElementById("fileName");

        const fileSize = document.getElementById("fileSize");


        // =====================================
        // GENERATE SLUG
        // =====================================

        function generateSlug(value) {

            return value
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/^-+|-+$/g, "");

        }


        // =====================================
        // EVENT TITLE PREVIEW
        // =====================================

        titleInput.addEventListener("input", function () {

            const slug = generateSlug(this.value);

            slugPreview.textContent =
                `/event/${slug || "your-event"}`;

        });


        // =====================================
        // DESCRIPTION CHARACTER COUNT
        // =====================================

        descriptionInput.addEventListener("input", function () {

            descriptionCount.textContent = this.value.length;

        });


        // =====================================
        // MINIMUM EVENT DATE
        // =====================================

        const eventDate = document.getElementById("eventDate");

        const today = new Date();

        const localToday = new Date(
            today.getTime() - today.getTimezoneOffset() * 60000
        ).toISOString().split("T")[0];

        eventDate.min = localToday;


        // =====================================
        // IMAGE UPLOAD
        // =====================================

        uploadArea.addEventListener("click", function (event) {

            if (
                event.target.id === "removeImage" ||
                event.target.closest("#removeImage")
            ) {
                return;
            }

            imageInput.click();

        });


        // =====================================
        // DISPLAY IMAGE
        // =====================================

        function displayImage(file) {

            if (!file) return;

            const allowedTypes = [
                "image/png",
                "image/jpeg"
            ];

            if (!allowedTypes.includes(file.type)) {

                alert("Please upload a PNG or JPG image.");

                imageInput.value = "";

                return;

            }

            if (file.size > 5 * 1024 * 1024) {

                alert("Image size must be less than 5MB.");

                imageInput.value = "";

                return;

            }

            const reader = new FileReader();

            reader.onload = function (event) {

                imagePreview.src = event.target.result;

                fileName.textContent = file.name;

                fileSize.textContent =
                    (file.size / 1024).toFixed(1) + " KB";

                uploadContent.hidden = true;

                selectedFile.hidden = false;

            };

            reader.readAsDataURL(file);

        }


        imageInput.addEventListener("change", function () {

            displayImage(this.files[0]);

        });


        // =====================================
        // REMOVE IMAGE
        // =====================================

        document.getElementById("removeImage")
            .addEventListener("click", function (event) {

                event.stopPropagation();

                imageInput.value = "";

                imagePreview.src = "";

                selectedFile.hidden = true;

                uploadContent.hidden = false;

            });


        // =====================================
        // DRAG AND DROP
        // =====================================

        uploadArea.addEventListener("dragover", function (event) {

            event.preventDefault();

            uploadArea.classList.add("dragging");

        });


        uploadArea.addEventListener("dragleave", function () {

            uploadArea.classList.remove("dragging");

        });


        uploadArea.addEventListener("drop", function (event) {

            event.preventDefault();

            uploadArea.classList.remove("dragging");

            const file = event.dataTransfer.files[0];

            if (!file) return;

            const dataTransfer = new DataTransfer();

            dataTransfer.items.add(file);

            imageInput.files = dataTransfer.files;

            displayImage(file);

        });


        // =====================================
        // STATUS SELECTION
        // =====================================

        document.querySelectorAll('input[name="status"]')
            .forEach(input => {

                input.addEventListener("change", function () {

                    document.querySelectorAll(".status-option")
                        .forEach(option => {

                            option.classList.remove("selected");

                        });

                    this.closest(".status-option")
                        .classList.add("selected");

                });

            });


        // =====================================
        // FORM VALIDATION
        // =====================================

        form.addEventListener("submit", function (event) {

            const startTime =
                document.getElementById("startTime").value;

            const endTime =
                document.getElementById("endTime").value;


            if (endTime <= startTime) {

                event.preventDefault();

                alert("End time must be later than start time.");

                return;

            }


            if (eventDate.value < localToday) {

                event.preventDefault();

                alert("Event date cannot be in the past.");

                return;

            }


            if (!form.checkValidity()) {

                event.preventDefault();

                form.reportValidity();

                return;

            }


            document.getElementById("submitEvent").disabled = true;

        });


        // =====================================
        // LOGOUT
        // =====================================

        const logoutButton =
            document.getElementById("logoutButton");

        if (logoutButton) {

            logoutButton.addEventListener("click", function () {

                if (confirm("Are you sure you want to logout?")) {

                    window.location.href = "/admin/logout";

                }

            });

        }

    </script>

</body>

</html>