<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OnEvent - Admin Dashboard</title>

    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>

<body>

    <div class="admin-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <a href="/admin/dashboard" class="brand">
                <img src="/images/OnEvent%20LOGO.png" alt="OnEvent">
                <span class="admin-badge">ADMIN</span>
            </a>

            <nav class="sidebar-nav">
            
                <a href="/admin/dashboard" class="nav-item active">
                    <img src="/icons/dashboard.svg" alt="">
                    <span>Dashboard</span>
                </a>
            
                <a href="/admin/events" class="nav-item">
                    <img src="/icons/calendar.svg" alt="">
                    <span>Events</span>
                </a>
            
                <a href="/admin/categories" class="nav-item">
                    <img src="/icons/shapes.svg" alt="">
                    <span>Categories</span>
                </a>
            
                <a href="/admin/users" class="nav-item">
                    <img src="/icons/users.svg" alt="">
                    <span>Users</span>
                </a>
            
                <a href="#" class="nav-item">
                    <img src="/icons/ticket.svg" alt="">
                    <span>Bookings</span>
                </a>
            
                <a href="#" class="nav-item">
                    <img src="/icons/shield-check.svg" alt="">
                    <span>Attendee Verification</span>
                </a>
            
                <a href="#" class="nav-item">
                    <img src="/icons/reports.svg" alt="">
                    <span>Reports &amp; Revenue</span>
                </a>
            
            </nav>

            <div class="sidebar-bottom">

                <div class="system-status">
                    <span class="status-dot"></span>

                    <div>
                        <small>SYSTEM STATUS</small>
                        <strong>Operational</strong>
                    </div>
                </div>

            </div>

        </aside>

        <!-- MAIN AREA -->
        <div class="main-area">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="breadcrumbs">
                    <span>Home</span>
                    <span class="breadcrumb-separator">/</span>
                    <strong>Dashboard</strong>
                </div>

                <div class="topbar-right">

                    <div class="admin-profile">
                        <span class="admin-avatar">SA</span>

                        <div class="admin-profile-info">
                            <strong>Admin Console</strong>
                            <small>Super Administrator</small>
                        </div>
                    </div>

                    <button
                        type="button"
                        class="topbar-logout"
                        id="logoutButton"
                        aria-label="Log out"
                        title="Log out"
                    >
                        <span>↪</span>
                        <span>Logout</span>
                    </button>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="page-content">

                <!-- PAGE HEADING -->
                <section class="page-heading">

                    <div class="heading-copy">

                        <div class="eyebrow">
                            <span>OPERATIONS SUITE</span>
                            <span class="eyebrow-divider">•</span>
                            <span class="eyebrow-muted">OVERVIEW</span>
                        </div>

                        <h1>Admin Dashboard</h1>

                        <p>
                            Welcome to OnEvent. Monitor your platform
                            activities and manage your operations.
                        </p>

                    </div>

                </section>

                <!-- STATISTICS CARDS -->
                <section class="stats-grid">

                    <!-- TOTAL USERS -->
                    <article class="stat-card">

                        <div class="stat-top">
                            <span>TOTAL REGISTERED USERS</span>
                            <span class="stat-icon purple">♙</span>
                        </div>

                        <h2><%= totalUsers ?? 0 %></h2>

                        <p>Registered user accounts</p>

                    </article>

                    <!-- TOTAL EVENTS -->
                    <article class="stat-card">

                        <div class="stat-top">
                            <span>TOTAL EVENTS</span>
                            <span class="stat-icon green">▣</span>
                        </div>

                        <h2><%= totalEvents ?? 0 %></h2>

                        <p>Events on the platform</p>

                    </article>

                    <!-- TOTAL BOOKINGS -->
                    <article class="stat-card">

                        <div class="stat-top">
                            <span>TOTAL BOOKINGS</span>
                            <span class="stat-icon violet">▤</span>
                        </div>

                        <h2><%= totalBookings ?? 0 %></h2>

                        <p>Bookings across all events</p>

                    </article>

                    <!-- TOTAL REVENUE -->
                    <article class="stat-card">

                        <div class="stat-top">
                            <span>TOTAL REVENUE</span>
                            <span class="stat-icon green">₹</span>
                        </div>

                        <h2>
                            ₹<%= Number(totalRevenue ?? 0).toLocaleString("en-IN") %>
                        </h2>

                        <p>Total booking revenue</p>

                    </article>

                </section>

                <!-- DASHBOARD LOWER SECTION -->
                <section class="dashboard-bottom">

                    <!-- RECENT ACTIVITY -->
                    <div class="table-card">

                        <div class="section-header">

                            <div>
                                <h2>Recent Activity</h2>
                                <p>Latest activities on your platform</p>
                            </div>

                        </div>

                        <% if (recentActivities && recentActivities.length > 0) { %>

                            <div class="activity-list">

                                <% recentActivities.forEach(activity => { %>

                                    <div class="activity-item">

                                        <div class="activity-icon">
                                            <%= activity.icon || "•" %>
                                        </div>

                                        <div class="activity-details">

                                            <strong>
                                                <%= activity.title %>
                                            </strong>

                                            <p>
                                                <%= activity.description %>
                                            </p>

                                        </div>

                                        <small class="activity-date">
                                            <%= activity.date
                                                ? new Date(activity.date).toLocaleDateString("en-IN")
                                                : "" %>
                                        </small>

                                    </div>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <div class="empty-state">
                                <strong>No recent activity</strong>
                                <p>Platform activities will appear here.</p>
                            </div>

                        <% } %>

                    </div>

                    <!-- QUICK ACTIONS -->
                    <div class="table-card">

                        <div class="section-header">

                            <div>
                                <h2>Quick Actions</h2>
                                <p>Access frequently used sections</p>
                            </div>

                        </div>

                        <div class="quick-actions">

                            <a href="/admin/events/add" class="quick-action">

                                <span class="quick-action-icon">＋</span>

                                <div>
                                    <strong>Add New Event</strong>
                                    <small>Create a new event</small>
                                </div>

                            </a>

                            <a href="/admin/events" class="quick-action">

                                <span class="quick-action-icon">▣</span>

                                <div>
                                    <strong>Manage Events</strong>
                                    <small>View and manage events</small>
                                </div>

                            </a>

                            <a href="/admin/categories" class="quick-action">

                                <span class="quick-action-icon">◇</span>

                                <div>
                                    <strong>Manage Categories</strong>
                                    <small>Organise event categories</small>
                                </div>

                            </a>

                            <a href="/admin/users" class="quick-action">

                                <span class="quick-action-icon">♙</span>

                                <div>
                                    <strong>Manage Users</strong>
                                    <small>View registered users</small>
                                </div>

                            </a>

                        </div>

                    </div>

                </section>

                <!-- FOOTER -->
                <footer class="page-footer">
                    <span>OnEvent Administration</span>
                    <span>Admin Dashboard</span>
                </footer>

            </main>

        </div>

    </div>

    <!-- LOGOUT CONFIRMATION -->
    <script>

        const logoutButton = document.getElementById("logoutButton");

        logoutButton.addEventListener("click", function () {

            const confirmLogout = confirm("Are you sure you want to logout?");

            if (confirmLogout) {
                window.location.replace("/admin/logout");
            }

        });

    </script>

</body>

</html>