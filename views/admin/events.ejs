<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OnEvent - Event Management</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <link rel="stylesheet" href="/css/admin/categories.css">
    <link rel="stylesheet" href="/css/admin/events.css">
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <a href="/admin/dashboard" class="brand">
            <img src="/images/OnEvent%20LOGO.png" alt="OnEvent">
            <span class="admin-badge">ADMIN</span>
        </a>

<nav class="sidebar-nav">

    <a href="/admin/dashboard" class="nav-item">
        <img src="/icons/dashboard.svg" alt="">
        <span>Dashboard</span>
    </a>

    <a href="/admin/events" class="nav-item active">
        <img src="/icons/calendar.svg" alt="">
        <span>Events</span>
    </a>

    <a href="/admin/categories" class="nav-item">
        <img src="/icons/shapes.svg" alt="">
        <span>Categories</span>
    </a>

    <a href="/admin/users" class="nav-item">
        <img src="/icons/users.svg" alt="">
        <span>Users</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/ticket.svg" alt="">
        <span>Bookings</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/shield-check.svg" alt="">
        <span>Attendee Verification</span>
    </a>

    <a href="#" class="nav-item">
        <img src="/icons/reports.svg" alt="">
        <span>Reports &amp; Revenue</span>
    </a>

</nav>

        <div class="sidebar-bottom">

            <div class="system-status">
                <span class="status-dot"></span>

                <div>
                    <small>SYSTEM STATUS</small>
                    <strong>Operational</strong>
                </div>
            </div>

        </div>

    </aside>


    <!-- MAIN AREA -->
    <div class="main-area">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="breadcrumbs">
                <a href="/admin/dashboard">Home</a>
                <span class="breadcrumb-separator">/</span>
                <strong>Events</strong>
            </div>

            <div class="topbar-right">

                <div class="date-badge">
                    <span class="date-icon">◷</span>
                    Last 30 Days
                </div>

                <button type="button" class="icon-button"
                    aria-label="Notifications">

                    <svg class="notification-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">

                        <path
                            d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                        <path
                            d="M10 21h4"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                        />

                    </svg>

                    <span class="notification-dot"></span>

                </button>

                <div class="admin-profile">

                    <span class="admin-avatar">SA</span>

                    <div class="admin-profile-info">
                        <strong>Admin Console</strong>
                        <small>Super Administrator</small>
                    </div>

                </div>

                <form action="/admin/logout" method="POST">

                    <button type="submit" class="topbar-logout">
                        <span>↪</span>
                        Logout
                    </button>

                </form>

            </div>

        </header>


        <!-- PAGE CONTENT -->
        <main class="page-content">

            <!-- PAGE HEADING -->
            <section class="page-heading">

                <div class="heading-copy">

                    <div class="eyebrow">
                        <span>OPERATIONS SUITE</span>
                        <span class="eyebrow-divider">•</span>
                        <span class="eyebrow-muted">
                            EVENT MANAGEMENT
                        </span>
                    </div>

                    <h1>Event Management</h1>

                    <p>
                        Create, organize and monitor events across
                        the OnEvent platform.
                    </p>

                </div>

                <div class="heading-actions">

                    <a href="/admin/events/new" class="primary-button">
                        <span class="button-icon">+</span>
                        Create Event
                    </a>

                </div>

            </section>


            <!-- ALERT MESSAGES -->
            <% if (successMessage) { %>

                <div class="category-alert success-alert">
                    <%= successMessage %>
                </div>

            <% } %>

            <% if (errorMessage) { %>

                <div class="category-alert error-alert">
                    <%= errorMessage %>
                </div>

            <% } %>


            <!-- STATISTICS -->
            <section class="stats-grid event-stats-grid">

                <!-- TOTAL EVENTS -->
                <article class="stat-card">

                    <div class="stat-top">

                        <span>TOTAL EVENTS</span>

                        <span class="stat-icon purple">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <path d="M8 8h8v8H8z"/>
                            </svg>
                        </span>

                    </div>

                    <h2><%= totalEvents %></h2>
                    <p>All registered events</p>

                </article>


                <!-- ACTIVE EVENTS -->
                <article class="stat-card">

                    <div class="stat-top">

                        <span>ACTIVE / LIVE</span>

                        <span class="stat-icon green">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"/>
                                <circle cx="12" cy="12" r="4"/>
                            </svg>
                        </span>

                    </div>

                    <h2><%= activeEvents %></h2>
                    <p>Currently live events</p>

                </article>


                <!-- DRAFT EVENTS -->
                <article class="stat-card">

                    <div class="stat-top">

                        <span>DRAFT / REVIEW</span>

                        <span class="stat-icon orange">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v5l3 2"/>
                            </svg>
                        </span>

                    </div>

                    <h2><%= draftEvents %></h2>
                    <p>Draft and scheduled events</p>

                </article>


                <!-- COMPLETED EVENTS -->
                <article class="stat-card">

                    <div class="stat-top">

                        <span>COMPLETED</span>

                        <span class="stat-icon gray">
                            <svg viewBox="0 0 24 24">
                                <path d="m5 12 5 5L20 7"/>
                            </svg>
                        </span>

                    </div>

                    <h2><%= completedEvents %></h2>
                    <p>Successfully completed events</p>

                </article>

            </section>


            <!-- FILTER PANEL -->
            <form
                action="/admin/events"
                method="GET"
                class="filter-panel event-filter-panel"
            >

                <!-- SEARCH -->
                <label class="search-box">

                    <img
                        src="/icons/search.svg"
                        alt=""
                        class="search-icon"
                    >

                    <input
                        type="search"
                        name="search"
                        placeholder="Search events by title, venue or ID..."
                        value="<%= search || '' %>"
                        aria-label="Search events"
                    >

                </label>


                <!-- CATEGORY -->
                <select name="category">

                    <option value="all"
                        <%= category === "all" ? "selected" : "" %>>
                        All Categories
                    </option>

                    <% categories.forEach(cat => { %>

                        <option
                            value="<%= cat._id %>"
                            <%= String(category) === String(cat._id) ? "selected" : "" %>
                        >
                            <%= cat.name %>
                        </option>

                    <% }) %>

                </select>


                <!-- STATUS -->
                <select name="status">

                    <option value="all"
                        <%= status === "all" ? "selected" : "" %>>
                        All Status
                    </option>

                    <option value="draft"
                        <%= status === "draft" ? "selected" : "" %>>
                        Draft
                    </option>

                    <option value="scheduled"
                        <%= status === "scheduled" ? "selected" : "" %>>
                        Scheduled
                    </option>

                    <option value="live"
                        <%= status === "live" ? "selected" : "" %>>
                        Live
                    </option>

                    <option value="completed"
                        <%= status === "completed" ? "selected" : "" %>>
                        Completed
                    </option>

                </select>


                <!-- SORT -->
                <select name="sort">

                    <option value="newest"
                        <%= sort === "newest" ? "selected" : "" %>>
                        Newest First
                    </option>

                    <option value="oldest"
                        <%= sort === "oldest" ? "selected" : "" %>>
                        Oldest First
                    </option>

                    <option value="az"
                        <%= sort === "az" ? "selected" : "" %>>
                        Name: A - Z
                    </option>

                    <option value="za"
                        <%= sort === "za" ? "selected" : "" %>>
                        Name: Z - A
                    </option>

                </select>



                <button
                    type="submit"
                    class="filter-button"
                    aria-label="Apply filters"
                >
                    <img src="/icons/search.svg" alt="">
                </button>


                <a href="/admin/events" class="clear-filters">
                    Clear
                </a>

            </form>


            <!-- EVENTS TABLE -->
            <section class="table-card">

                <div class="table-scroll">

                    <table class="users-table events-table">

                        <thead>

                            <tr>
                                <th>EVENT</th>
                                <th>CATEGORY</th>
                                <th>DATE & TIME</th>
                                <th>VENUE</th>
                                <th>TICKET SALES</th>
                                <th>STATUS</th>
                                <th class="actions-heading">ACTIONS</th>
                            </tr>

                        </thead>


                        <tbody>

                            <% if (events.length === 0) { %>

                                <tr>

                                    <td colspan="7" class="empty-state">

                                        <div class="empty-icon">
                                            <img src="/icons/search.svg" alt="">
                                        </div>

                                        <strong>No events found</strong>

                                        <p>
                                            Try changing your search or filters.
                                        </p>

                                    </td>

                                </tr>

                            <% } else { %>

                                <% events.forEach(event => { %>

                                    <tr>

                                        <!-- EVENT -->
                                        <td>

                                            <div class="event-cell">

                                                <div class="event-image">

                                                    <% if (event.imageUrl) { %>

                                                        <img
                                                            src="<%= event.imageUrl %>"
                                                            alt="<%= event.title %>"
                                                            loading="lazy"
                                                        >

                                                    <% } else { %>

                                                        <span>▣</span>

                                                    <% } %>

                                                </div>

                                                <div class="event-info">

                                                    <strong>
                                                        <%= event.title %>
                                                    </strong>

                                                    <small>
                                                        <%= event.eventId %>
                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- CATEGORY -->
                                        <td>

                                            <span class="event-category">
                                                <%= event.categoryId
                                                    ? event.categoryId.name
                                                    : "Uncategorized" %>
                                            </span>

                                        </td>


                                        <!-- DATE AND TIME -->
                                        <td>

                                            <span class="event-date">

                                                <%= new Date(event.eventDate)
                                                    .toLocaleDateString("en-GB", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    }) %>

                                            </span>

                                            <span class="event-time">
                                                <%= event.startTime %>
                                                -
                                                <%= event.endTime %>
                                            </span>

                                        </td>


                                        <!-- VENUE -->
                                        <td>

                                            <div class="event-venue">

                                                <strong>
                                                    <%= event.venue %>
                                                </strong>

                                                <small>
                                                    <%= event.location %>
                                                </small>

                                            </div>

                                        </td>


                                        <!-- TICKET SALES -->
                                        <td>

                                            <%
                                                const sold = Number(event.ticketsSold || 0);
                                                const total = Number(event.totalTickets || 0);

                                                const percentage = total > 0
                                                    ? Math.min(100, Math.round((sold / total) * 100))
                                                    : 0;
                                            %>

                                            <div class="ticket-progress-info">

                                                <strong>
                                                    <%= sold %> / <%= total %>
                                                </strong>

                                                <span><%= percentage %>%</span>

                                            </div>

                                            <div class="ticket-progress">

                                                <div
                                                    class="ticket-progress-fill"
                                                    style="width: <%= percentage %>%"
                                                ></div>

                                            </div>

                                            <small class="available-tickets">
                                                <%= event.availableTickets %> available
                                            </small>

                                        </td>


                                        <!-- STATUS -->
                                        <td>

                                            <span class="status-badge event-status-<%= event.status %>">

                                                <span></span>

                                                <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>

                                            </span>

                                        </td>


                                        <!-- ACTIONS -->
                                        <td>

                                            <div class="action-buttons">

                                                <a
                                                    href="/admin/events/<%= event._id %>"
                                                    class="action-button view-btn"
                                                >
                                                    View
                                                </a>

                                                <a
                                                    href="/admin/events/edit/<%= event._id %>"
                                                    class="action-button edit-btn"
                                                >
                                                    Edit
                                                </a>

                                                <form
                                                    action="/admin/events/delete/<%= event._id %>"
                                                    method="POST"
                                                    class="delete-form"
                                                    data-name="<%= event.title %>"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="action-button delete-btn"
                                                    >
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- TABLE FOOTER -->
                <div class="table-footer">

                    <div class="table-summary">

                        Showing

                        <strong>
                            <%= events.length > 0
                                ? ((currentPage - 1) * limit) + 1
                                : 0 %>

                            –

                            <%= ((currentPage - 1) * limit) + events.length %>
                        </strong>

                        events of

                        <strong><%= totalEventsFiltered %></strong>

                    </div>


                    <!-- PAGINATION -->
                    <div class="pagination">

                        <% if (currentPage > 1) { %>

                            <a
                                class="page-button"
                                href="/admin/events?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&category=<%= category || 'all' %>&status=<%= status || 'all' %>&sort=<%= sort || 'newest' %>&limit=<%= limit %>"
                            >
                                Previous
                            </a>

                        <% } else { %>

                            <button class="page-button" disabled>
                                Previous
                            </button>

                        <% } %>


                        <% for (let p = 1; p <= totalPages; p++) { %>

                            <a
                                class="page-number <%= p === currentPage ? 'current-page' : '' %>"
                                href="/admin/events?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&category=<%= category || 'all' %>&status=<%= status || 'all' %>&sort=<%= sort || 'newest' %>&limit=<%= limit %>"
                            >
                                <%= p %>
                            </a>

                        <% } %>


                        <% if (currentPage < totalPages) { %>

                            <a
                                class="page-button"
                                href="/admin/events?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&category=<%= category || 'all' %>&status=<%= status || 'all' %>&sort=<%= sort || 'newest' %>&limit=<%= limit %>"
                            >
                                Next
                            </a>

                        <% } else { %>

                            <button class="page-button" disabled>
                                Next
                            </button>

                        <% } %>

                    </div>

                </div>

            </section>


            <!-- FOOTER -->
            <footer class="page-footer">

                <span>OnEvent Administration</span>
                <span>Event Management</span>

            </footer>

        </main>

    </div>

</div>


<!-- DELETE CONFIRMATION -->
<div class="event-delete-modal" id="eventDeleteModal">

    <div class="event-delete-content">

        <div class="event-delete-icon">!</div>

        <h2>Delete Event?</h2>

        <p>
            Are you sure you want to delete
            <strong id="deleteEventName"></strong>?
        </p>

        <p class="event-delete-warning">
            This event will be removed from your event list.
        </p>

        <div class="event-delete-actions">

            <button type="button" class="secondary-button"
                onclick="closeEventDeleteModal()">
                Cancel
            </button>

            <button type="button" class="event-delete-confirm"
                id="confirmEventDelete">
                Yes, Delete
            </button>

        </div>

    </div>

</div>


<script>

// ========================================
// DELETE EVENT CONFIRMATION
// ========================================

const deleteModal = document.getElementById("eventDeleteModal");

const deleteEventName = document.getElementById("deleteEventName");

const confirmDeleteButton = document.getElementById("confirmEventDelete");

let selectedDeleteForm = null;

document.querySelectorAll(".delete-form").forEach(form => {

    form.addEventListener("submit", function(event) {

        event.preventDefault();

        selectedDeleteForm = this;

        deleteEventName.textContent = this.dataset.name;

        deleteModal.classList.add("show");

    });

});


function closeEventDeleteModal() {

    deleteModal.classList.remove("show");

    selectedDeleteForm = null;

}


confirmDeleteButton.addEventListener("click", function() {

    if (selectedDeleteForm) {
        selectedDeleteForm.submit();
    }

});


deleteModal.addEventListener("click", function(event) {

    if (event.target === deleteModal) {
        closeEventDeleteModal();
    }

});


document.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {
        closeEventDeleteModal();
    }

});


// ========================================
// AUTO DISMISS ALERTS
// ========================================

const successAlert = document.querySelector(".success-alert");

const errorAlert = document.querySelector(".error-alert");

[successAlert, errorAlert].forEach(alert => {

    if (!alert) return;

    setTimeout(() => {

        alert.classList.add("fade-out");

        setTimeout(() => alert.remove(), 400);

    }, 3000);

});


// Remove success/error parameters from URL after displaying the message.

if (successAlert || errorAlert) {

    const currentUrl = new URL(window.location.href);

    currentUrl.searchParams.delete("success");
    currentUrl.searchParams.delete("error");

    window.history.replaceState(
        {},
        document.title,
        currentUrl.pathname + currentUrl.search + currentUrl.hash
    );

}

</script>

</body>
</html>